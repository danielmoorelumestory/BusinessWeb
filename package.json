{
  "name": "study01-react-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "skills:package": "node scripts/generate-investment-method.mjs && node scripts/generate-future-trends-skill.mjs && python3 scripts/package-investment-skills.py",
    "future-trends:picks": "sh scripts/future-trends-picks/run.sh",
    "test:edge": "node --test server/edge/*.test.mjs",
    "dev": "vite --host",
    "dev:notes": "MAIN_SITE=/ npm --prefix notes-site run build && npm --prefix notes-site run preview -- --port 4322",
    "valuation:server": "node server/valuation/index.mjs",
    "valuation": "node scripts/valuation-cli.mjs",
    "valuation:app": "node scripts/valuation-app.mjs",
    "test:valuation-server": "node --test server/valuation/*.test.mjs",
    "test": "node scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.valuation.json",
    "prebuild": "node scripts/generate-changelog.mjs && node scripts/generate-sitemap.mjs",
    "build": "vite build && node scripts/prerender-routes.mjs",
    "preview": "vite preview",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:pages": "VITE_BASE_PATH=/BusinessWeb/ VITE_MARKET_DIRECT=true vite build && node scripts/prepare-pages.mjs && node scripts/prerender-routes.mjs",
    "test:functions": "node scripts/check-functions.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "macro:update": "node scripts/macro-snapshot.mjs",
    "index:update": "node scripts/index-snapshot.mjs",
    "index:fpe": "node scripts/index-snapshot.mjs fpe",
    "index:fpe-import": "node scripts/index-snapshot.mjs fpe-import",
    "index:ref-import": "node scripts/index-snapshot.mjs ref-import"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "lucide-react": "^0.562.0",
    "marked": "^18.0.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.1.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.11"
  }
}
