# Optional front-end build settings. Vercel defaults to the root path.
VITE_BASE_PATH=/
VITE_MARKET_DIRECT=false

# SERVER ONLY. Never prefix these with VITE_. Set them in the platform's environment settings; leave empty to disable.
# Daily review + candidate pool sync: Cloudflare D1 binding named DB (see d1/schema.sql) plus this token (>=32 chars).
PULSE_SYNC_TOKEN=
# Chapter comments only (Supabase):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
COMMENTS_ADMIN_TOKEN=

# Optional external Python AKTools service. This is not provided by Vercel.
VITE_AKTOOLS_BASE_URL=

# 本地调试 notes-site 时，让网格交易/股市分析入口跳到本机而不是线上（默认 https://businessweb-c0u.pages.dev）
# 先 cd notes-site && npm run dev，再在 .env.local 里写：
# VITE_NOTES_ORIGIN=http://localhost:4321
# SERVER ONLY: independent private-library credentials (>=32 chars, all distinct).
KNOWLEDGE_READ_TOKEN=
KNOWLEDGE_MCP_TOKEN=
KNOWLEDGE_UPLOAD_TOKEN=

# SERVER ONLY: independent read/write Obsidian sync credential, >=32 chars.
KNOWLEDGE_SYNC_TOKEN=

# SERVER ONLY: comments admin credential (>=32 chars, independent of other tokens).
COMMENTS_ADMIN_TOKEN=

# SERVER ONLY: AI 试问（api/ask.ts）。key 只放 Vercel 环境变量，绝不加 VITE_ 前缀、不要提交。
SUPABASE_ANON_KEY=
MINIMAX_API_KEY=
# 可选：默认 https://api.minimaxi.com/anthropic 与 MiniMax-M2
MINIMAX_BASE_URL=
MINIMAX_MODEL=

# Front-end（公开信息，anon key 本来就是公开的）：Google / GitHub 登录用。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 可选：同一 IP 每天上限（默认 6）与全站每天总上限（默认 300）
ASK_IP_LIMIT=
ASK_GLOBAL_LIMIT=
