{
  "version": 1,
  "maxParallel": 3,
  "paths": {
    "android": [],
    "frontend": [
      "src"
    ],
    "backend": [
      "server",
      "api",
      "supabase"
    ]
  },
  "checks": {
    "android": [],
    "frontend": [
      "npm run typecheck",
      "npm run test",
      "npm run build"
    ],
    "backend": [
      "npm run test:knowledge",
      "npm run test:valuation-server"
    ]
  },
  "harnesses": {
    "codex": {
      "agent": "codex",
      "command": "codex",
      "enabled": true
    },
    "claude": {
      "agent": "claude",
      "command": "claude",
      "enabled": true
    },
    "opencode-m3": {
      "agent": "opencode",
      "command": "opencode",
      "model": "minimax-cn/MiniMax-M3",
      "launchMode": "terminal",
      "enabled": true
    },
    "kimi": {
      "agent": "kimi",
      "command": "kimi",
      "enabled": true
    },
    "agy": {
      "agent": "antigravity",
      "command": "agy",
      "enabled": true
    }
  },
  "routing": {
    "manager": [
      "codex",
      "claude",
      "kimi",
      "agy",
      "opencode-m3"
    ],
    "architect": [
      "codex",
      "claude",
      "opencode-m3",
      "kimi",
      "agy"
    ],
    "designer": [
      "claude",
      "codex",
      "agy",
      "kimi",
      "opencode-m3"
    ],
    "android": [
      "codex",
      "claude",
      "opencode-m3",
      "kimi",
      "agy"
    ],
    "frontend": [
      "claude",
      "codex",
      "opencode-m3",
      "agy",
      "kimi"
    ],
    "backend": [
      "codex",
      "claude",
      "opencode-m3",
      "kimi",
      "agy"
    ],
    "reviewer": [
      "claude",
      "codex",
      "kimi",
      "opencode-m3",
      "agy"
    ],
    "qa": [
      "codex",
      "claude",
      "kimi",
      "opencode-m3",
      "agy"
    ],
    "researcher": [
      "kimi",
      "agy",
      "claude",
      "codex",
      "opencode-m3"
    ]
  }
}
