---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const gridListUrl = href('lab/grid-trading/saved');
const calculatorUrl = href('lab/grid-trading');
const detailUrl = href('lab/grid-trading/detail');
const notesBase = (process.env.MAIN_SITE || 'https://businessweb-c0u.pages.dev/').replace(/\/?$/, '/') + 'notes/';
---

<Base wide title="ETF 复盘" current="lab" description="按分组观察 ETF，记录每日判断，并集中查看行情、网格状态与盈亏">
  <header class="hero compact-hero">
    <p class="kicker">ETF REVIEW</p>
    <h1>ETF 复盘</h1>
  </header>

  <div class="page-actions">
    <div>
      <a class="link-button" href={gridListUrl}>网格列表</a>
      <a class="link-button" href={calculatorUrl}>网格计算器</a>
    </div>
    <span id="market-status" role="status"></span>
  </div>

  <section class="sync-panel" aria-label="云端同步">
    <div><strong>云端同步</strong><p>ETF 笔记、分组和网格记录共用同一同步密钥。</p></div>
    <label>同步密钥 <input id="sync-key" type="text" autocomplete="off" spellcheck="false"></label>
    <button id="copy-sync-key" type="button">复制密钥</button>
    <button id="upload-records" class="sync-primary" type="button" title="将本机数据上传到云端，不改变本机数据">上传云端</button>
    <button id="pull-records" type="button" title="读取云端数据并安全合并到本机，不上传本机数据">拉取云端</button>
    <span id="sync-status" role="status"></span>
  </section>

  <section class="review-toolbar" aria-label="分组筛选和标的管理">
    <div class="toolbar-actions">
      <button id="manage-groups" type="button">管理分组</button>
      <button id="add-watch" class="primary" type="button">添加标的</button>
    </div>
    <nav id="group-filters" class="industry-etf-nav" aria-label="分组目录"></nav>
  </section>

  <div id="content-area" data-detail-url={detailUrl} data-calc-url={calculatorUrl} data-notes-base={notesBase}></div>

  <dialog id="add-dialog">
    <form id="add-form">
      <header><h2>添加观察标的</h2><button class="dialog-close" type="button" aria-label="关闭">×</button></header>
      <label>ETF 代码<input id="add-code" name="code" inputmode="numeric" maxlength="6" pattern="\d{6}" required placeholder="例如 510300"></label>
      <label>名称（可选）<input id="add-name" name="name" maxlength="30" placeholder="例如 沪深300ETF"></label>
      <label>所属分组<select id="add-group"><option value="">未分组</option></select></label>
      <p id="add-error" class="form-error" role="alert"></p>
      <footer><button class="dialog-close" type="button">取消</button><button class="primary" type="submit">添加</button></footer>
    </form>
  </dialog>

  <dialog id="note-dialog">
    <form id="note-form">
      <header><h2 id="note-title">每日笔记</h2><button class="dialog-close" type="button" aria-label="关闭">×</button></header>
      <input id="note-code" type="hidden">
      <label>日期<input id="note-date" type="date" required></label>
      <label>ETF 溢价<output id="note-premium" aria-live="polite">—</output></label>
      <div class="form-grid">
        <label>情绪<select id="note-emotion"><option value="">未选择</option><option>冷静</option><option>犹豫</option><option>FOMO</option><option>恐慌</option></select></label>
        <label>结论<select id="note-conclusion"><option value="">未选择</option><option>看多</option><option>中性</option><option>看空</option></select></label>
        <label>计划动作<select id="note-action"><option value="">未选择</option><option>加仓</option><option>减仓</option><option>观望</option><option>调参</option></select></label>
      </div>
      <label>风险点<textarea id="note-risk" maxlength="200" rows="3"></textarea></label>
      <label>备注<textarea id="note-remark" maxlength="500" rows="5"></textarea></label>
      <footer><span id="note-status" role="status"></span><button class="dialog-close" type="button">取消</button><button class="primary" type="submit">保存</button></footer>
    </form>
  </dialog>

  <dialog id="membership-dialog">
    <form id="membership-form">
      <header><h2 id="membership-title">编辑分组</h2><button class="dialog-close" type="button" aria-label="关闭">×</button></header>
      <input id="membership-code" type="hidden">
      <div id="membership-options" class="check-list"></div>
      <footer><span id="membership-status" role="status"></span><button class="dialog-close" type="button">取消</button><button class="primary" type="submit">保存</button></footer>
    </form>
  </dialog>

  <dialog id="groups-dialog">
    <form id="groups-form">
      <header><h2>管理分组</h2><button class="dialog-close" type="button" aria-label="关闭">×</button></header>
      <p class="dialog-help">删除分组只会移除标签，不会删除 ETF。</p>
      <div id="groups-editor" class="groups-editor"></div>
      <button id="new-group" type="button">＋ 新增分组</button>
      <footer><span id="groups-status" role="status"></span><button class="dialog-close" type="button">取消</button><button class="primary" type="submit">保存</button></footer>
    </form>
  </dialog>
</Base>

<script>
  import {
    addWatch,
    captureDailyPremiums,
    filterByGroups,
    noteKey,
    poolCodes,
    orderedGroupCodes,
    moveGroupCode,
    readMeta,
    removeWatch,
    setMemberships,
    upsertDailyNote,
    writeMeta,
    type DailyNote,
    type ReviewGroup,
  } from '../../../lib/etf-review';
  import {
    blockCopy,
    fetchQuotes,
    formatMoney,
    formatPrice,
    gridStatus,
    marketToday,
    readGridRecords,
    recordByCode,
    removeRecords,
    uploadAll,
    pullAll,
    SYNC_KEY_STORAGE,
    type Quote,
    type SavedRecord,
  } from '../../../lib/grid-trading';
  import { renderReviewAnalysis, canRefreshReviewAnalysis, setReviewRecord } from '../../../lib/review-analysis';
  import { fundProfileUrl, isCatalogGroupId, subThemeCellHtml } from '../../../lib/etf-catalog-seed';
  import { fillCatalogRemarks, referenceSectionsHtml } from '../../../lib/etf-catalog-special';
  import { latestInvestmentNote } from '../../../../../src/utils/etfJudgment';

  import { loadReviewTechnical, readTechnicalCache } from '../../../lib/review-technical-client';

  blockCopy();

  const container = document.querySelector('#content-area') as HTMLElement;
  const detailUrl = container.dataset.detailUrl!;
  const calcUrl = container.dataset.calcUrl!;
  const notesBase = container.dataset.notesBase!;
  const filterBar = document.querySelector('#group-filters') as HTMLElement;
  const marketStatus = document.querySelector('#market-status') as HTMLElement;
  const syncInput = document.querySelector('#sync-key') as HTMLInputElement;
  const syncStatus = document.querySelector('#sync-status') as HTMLElement;
  const selectedGroupIds = new Set<string>();
  let quotes = new Map<string, Quote>();
  const analysisRequests = new Set<string>();

  async function updateAnalysis(codes: string[]) {
    const pending = [...new Set(codes)].filter(code => /^\d{6}$/.test(code) && canRefreshReviewAnalysis(code) && !analysisRequests.has(code));
    if (!pending.length) return;
    pending.forEach(code => analysisRequests.add(code));
    const apply = (code: string, record: Parameters<typeof setReviewRecord>[1]) => {
      if (!setReviewRecord(code, record)) return;
      const template = document.createElement('template');
      container.querySelectorAll<HTMLTableRowElement>('tr[data-code]').forEach(row => {
        if (row.dataset.code !== code) return;
        for (const period of ['day', 'week', 'month'] as const) {
          template.innerHTML = renderReviewAnalysis(code, period, notesBase, true);
          const cell = template.content.firstElementChild;
          if (cell) row.querySelector(`[data-analysis="${period}"]`)?.replaceWith(cell);
        }
      });
    };
    try { await loadReviewTechnical(pending, apply); } catch (error) {
      pending.forEach(code => analysisRequests.delete(code));
      marketStatus.textContent = error instanceof Error ? error.message : '指标更新失败，保留原状态';
    }
  }

  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]!));
  const attr = (value: unknown) => escapeHtml(value);
  const dialogs = [...document.querySelectorAll<HTMLDialogElement>('dialog')];
  const openDialog = (dialog: HTMLDialogElement) => dialog.showModal();
  const closeDialog = (dialog: HTMLDialogElement) => dialog.close();
  const groupsOf = () => [...readMeta().groups].sort((a, b) => a.order - b.order);

  function pillHtml(id: string, name: string) {
    const active = id === '' ? !selectedGroupIds.size : selectedGroupIds.has(id);
    return `<button class="industry-etf-nav__pill industry-etf-nav__pill--primary${active ? ' is-active' : ''}" data-group="${attr(id)}" type="button"><span>${escapeHtml(name)}</span></button>`;
  }

  function renderFilters() {
    const groups = groupsOf();
    for (const id of [...selectedGroupIds]) if (!groups.some(group => group.id === id)) selectedGroupIds.delete(id);
    filterBar.innerHTML = `
      <div class="industry-etf-nav__group">
        ${pillHtml('', '全部')}
        ${groups.map(group => pillHtml(group.id, group.name)).join('')}
      </div>
    `;
  }

  function statusCell(record?: SavedRecord, code = '') {
    if (!record) {
      return `<td class="status-cell"><a class="grid-calc-entry" href="${calcUrl}?code=${encodeURIComponent(code)}" title="未配置网格，点击去网格计算器">未挂网格 <span class="arrow">↗</span></a></td>`;
    }
    const status = gridStatus(record);
    if (!status) return '<td class="status-cell muted">—</td>';
    return `<td class="status-cell"><span class="status-badge ${status.tone}${status.reached ? ' reached' : ''}">${escapeHtml(status.label)}</span><span>${escapeHtml(status.detail)}</span></td>`;
  }

  function lastTradePnlCell(record: SavedRecord | undefined, current: number | undefined) {
    const trade = record?.result.trades?.at(-1);
    if (!trade || !Number.isFinite(trade.price) || trade.price <= 0 || current === undefined || !Number.isFinite(current) || current <= 0) {
      return '<td class="computed muted">—</td>';
    }
    const percent = (current / trade.price - 1) * 100;
    const text = `${percent > 0 ? '+' : ''}${percent.toFixed(2)}%`;
    const title = `${trade.date} ${trade.side}，成交价 ${formatPrice(trade.price)}；（现价 ÷ 成交价 − 1）× 100%`;
    return `<td class="computed ${percent > 0 ? 'up' : percent < 0 ? 'down' : 'muted'}" title="${attr(title)}">${escapeHtml(text)}</td>`;
  }

  function rowHtml(
    code: string,
    meta: ReturnType<typeof readMeta>,
    watchByCode: Map<string, { code: string; name: string }>,
    noteDates: string[],
    position: number,
    total: number,
  ) {
    const candidate = recordByCode(code);
    const record = candidate?.watch ? undefined : candidate;
    const watch = watchByCode.get(code);
    const name = record?.row.name || watch?.name || quotes.get(code)?.name || code;
    const price = quotes.get(code)?.price ?? record?.result.current;
    const changePercent = quotes.get(code)?.changePercent;
    const changeText = changePercent === undefined ? '—' : `${changePercent > 0 ? '+' : ''}${changePercent.toFixed(2)}%`;
    const changeTone = changePercent === undefined || changePercent === 0 ? 'muted' : changePercent > 0 ? 'up' : 'down';
    return `<tr data-code="${attr(code)}">
      <td class="identity-cell"><div class="stock-name">${escapeHtml(name)}</div><div class="code-cell">${escapeHtml(code)}</div><div class="position-actions"><button type="button" data-action="move-up" aria-label="上移 ${attr(name)}" title="在本分组上移" ${position === 0 ? 'disabled' : ''}>↑</button><button type="button" data-action="move-down" aria-label="下移 ${attr(name)}" title="在本分组下移" ${position === total - 1 ? 'disabled' : ''}>↓</button></div></td>
      ${subThemeCellHtml(code, escapeHtml)}
      <td class="computed"><div>${formatPrice(price)}</div><div class="daily-change ${changeTone}" title="当日涨跌幅">${changeText}</div></td>
      ${renderReviewAnalysis(code, 'day', notesBase, true)}
      ${renderReviewAnalysis(code, 'week', notesBase, true)}
      ${renderReviewAnalysis(code, 'month', notesBase, true)}
      ${lastTradePnlCell(record, price)}
      ${statusCell(record, code)}
      <td class="computed ${record ? (record.result.pnl >= 0 ? 'up' : 'down') : 'muted'}">${record ? escapeHtml(formatMoney(record.result.pnl)) : '—'}</td>
      ${noteDates.map(date => {
        const note = meta.notes[noteKey(code, date)];
        const premium = meta.dailyPremiums?.[noteKey(code, date)];
        const premiumText = premium ? `${premium.rate > 0 ? '+' : ''}${premium.rate.toFixed(2)}%` : '—';
        const premiumTone = !premium || premium.rate === 0 ? 'muted' : premium.rate > 0 ? 'up' : 'down';
        const premiumTitle = premium ? `${premium.quoteDate} 腾讯行情折溢价${premium.referenceNav ? `；参考净值 ${premium.referenceNav}` : ''}` : '暂无该日溢价记录';
        const noteText = note ? [note.emotion, note.conclusion, note.action].filter(Boolean).join('·') || '已写' : '未写';
        return `<td><button class="text-action note-action${note?.risk?.trim() ? ' has-risk' : ''}" title="${note?.risk?.trim() ? '已填写风险点' : '编辑笔记'}" data-action="note" data-date="${attr(date)}" aria-label="${attr(`${date} 笔记：${noteText}`)}" type="button">${escapeHtml(noteText)}</button><div class="note-premium ${premiumTone}" title="${attr(premiumTitle)}">溢价 ${premiumText}</div></td>`;
      }).join('')}
      <td class="action-cell">
        <div class="row-actions">
          <button data-action="groups" type="button">编辑分组</button>
          ${(() => {
            const analysis = latestInvestmentNote(code);
            return analysis ? `<a href="${attr(notesBase + encodeURIComponent(analysis.slug) + '/')}" target="_blank" rel="noopener">分析报告</a>` : '';
          })()}
          <a href="${attr(fundProfileUrl(code))}" target="_blank" rel="noopener">基金档案</a>
          <a href="${record ? `${detailUrl}?id=${encodeURIComponent(record.id)}` : `${detailUrl}?code=${encodeURIComponent(code)}&name=${encodeURIComponent(name)}`}">网格详情</a>
          <button class="danger" data-action="remove" type="button">移出标的</button>
        </div>
      </td>
    </tr>`;
  }

  function sectionHtml(title: string, codes: string[], row: (code: string, position: number, total: number) => string, noteDates: string[], groupId = '') {
    if (!codes.length) return '';
    return `
      <section class="group-section" aria-label="${attr(title)}" data-group-id="${attr(groupId)}">
        <div class="group-card">
          <div class="group-card-header">
            <h2 class="group-heading">${escapeHtml(title)}</h2>
            <span class="group-count">${codes.length} 只 ETF</span>
          </div>
          <div class="table-shell">
            <table class="review-table">
              <colgroup>
                <col style="width:180px"><col style="width:200px"><col style="width:110px"><col style="width:290px"><col style="width:290px"><col style="width:290px">
                <col style="width:120px"><col style="width:150px"><col style="width:100px">
                ${noteDates.map(() => '<col style="width:140px">').join('')}<col style="width:96px">
              </colgroup>
              <thead><tr><th>名称 / 代码</th><th>行业分布</th><th>现价 / 涨跌幅</th><th>日线</th><th>周线</th><th>月线</th><th>最近一笔盈亏</th><th>网格状态</th><th>盈亏</th>${noteDates.map(date => `<th title="${attr(date)}"><span class="note-heading">笔记</span><time datetime="${attr(date)}">${escapeHtml(date.slice(5))}</time></th>`).join('')}<th>操作</th></tr></thead>
              <tbody>${codes.map((code, position) => row(code, position, codes.length)).join('')}</tbody>
            </table>
          </div>
        </div>
      </section>`;
  }

  function migrateUngroupedToHeld() {
    const meta = readMeta();
    const grid = readGridRecords();
    const allCodes = poolCodes(grid.map(item => item.row.code.trim()), meta.watchlist);
    const groups = groupsOf();
    const heldGroup = groups.find(g => g.name === '已持仓' || g.id === 'g-held') ?? groups[0];
    if (!heldGroup) return;

    const ungrouped = allCodes.filter(code => !(meta.memberships[code] ?? []).length);
    if (!ungrouped.length) return;

    const memberships = { ...meta.memberships };
    for (const code of ungrouped) {
      memberships[code] = [heldGroup.id];
    }
    writeMeta({
      ...meta,
      memberships,
      updatedAt: new Date().toISOString(),
    });
    void saveLocalChanges('分组设置');
  }

  function syncFocusToRegular() {
    const meta = readMeta();
    const groups = groupsOf();
    const focusGroup = groups.find(g => g.name === '重点观察' || g.id === 'g-focus');
    const regularGroup = groups.find(g => g.name === '常规列表' || g.name === '常规');
    if (!focusGroup || !regularGroup) return;

    const grid = readGridRecords();
    const allCodes = poolCodes(grid.map(item => item.row.code.trim()), meta.watchlist);
    const focusCodes = allCodes.filter(code => (meta.memberships[code] ?? []).includes(focusGroup.id));
    if (!focusCodes.length) return;

    let changed = false;
    const memberships = { ...meta.memberships };
    for (const code of focusCodes) {
      const current = memberships[code] ?? [];
      if (!current.includes(regularGroup.id)) {
        memberships[code] = [...current, regularGroup.id];
        changed = true;
      }
    }

    if (!changed) return;

    writeMeta({
      ...meta,
      memberships,
      updatedAt: new Date().toISOString(),
    });
    void saveLocalChanges('分组设置');
  }

  function render() {
    const meta = readMeta();
    const grid = readGridRecords();
    const allCodes = poolCodes(grid.map(item => item.row.code.trim()), meta.watchlist);
    const cached = readTechnicalCache();
    for (const code of allCodes) if (cached[code]) setReviewRecord(code, cached[code].record);
    const codes = filterByGroups(allCodes, meta.memberships, [...selectedGroupIds]);
    const groups = groupsOf();
    const watchByCode = new Map(meta.watchlist.map(item => [item.code, item]));
    renderFilters();

    if (!codes.length) {
      container.innerHTML = `<div class="empty"><div>📋</div><h3>${allCodes.length ? '当前筛选没有标的' : '观察池还是空的'}</h3><p>${allCodes.length ? '请选择其他分组或切回“全部”。' : '添加一个 6 位 ETF 代码，或先在网格计算器保存回测。'}</p><button id="empty-add" class="primary" type="button">添加标的</button></div>${referenceSectionsHtml(notesBase, escapeHtml, attr)}`;
      void fillCatalogRemarks(container, notesBase, escapeHtml);
      return;
    }

    const today = marketToday();
    const noteDates = Array.from({ length: 5 }, (_, index) => {
      const date = new Date(`${today}T00:00:00Z`);
      date.setUTCDate(date.getUTCDate() - index);
      return date.toISOString().slice(0, 10);
    });
    const row = (code: string, position: number, total: number) => rowHtml(code, meta, watchByCode, noteDates, position, total);
    const visibleGroups = selectedGroupIds.size ? groups.filter(group => selectedGroupIds.has(group.id)) : groups;
    const sections = visibleGroups.map(group => {
      const inGroup = orderedGroupCodes(codes.filter(code => (meta.memberships[code] ?? []).includes(group.id)), meta.groupCodeOrder?.[group.id]);
      return sectionHtml(group.name, inGroup, row, noteDates, group.id);
    });
    // 「全部」时附上未分组；筛选分组时不展示未分组块
    if (!selectedGroupIds.size) {
      const ungrouped = orderedGroupCodes(codes.filter(code => !(meta.memberships[code] ?? []).length), meta.groupCodeOrder?.['']);
      sections.push(sectionHtml('未分组', ungrouped, row, noteDates));
    }
    // 筛选后若某组为空则整块省略；若所有块都空（理论上不会，codes 非空）给兜底
    const body = sections.filter(Boolean).join('') || sectionHtml('筛选结果', codes, row, noteDates);
    // 货币/债基：industry-etf 原样只读，不参与分组筛选
    container.innerHTML = `<div class="group-sections">${body}</div>${referenceSectionsHtml(notesBase, escapeHtml, attr)}`;
    void fillCatalogRemarks(container, notesBase, escapeHtml);
  }

  async function updateQuotes() {
    const meta = readMeta();
    const codes = poolCodes(readGridRecords().map(item => item.row.code.trim()), meta.watchlist);
    if (!codes.length) return;
    marketStatus.textContent = '正在刷新报价…';
    quotes = await fetchQuotes(codes);
    try {
      if (captureDailyPremiums([...quotes.values()], marketToday())) {
        void saveLocalChanges('每日溢价').catch(reason => { syncStatus.textContent = saveError(reason); });
      }
    } catch (reason) { syncStatus.textContent = saveError(reason); }
    render();
    void updateAnalysis(codes);
    if (noteDialog.open) renderNotePremium();
    marketStatus.textContent = quotes.size ? `报价更新于 ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}` : '暂未取得实时报价';
  }

  async function saveLocalChanges(label: string) {
    syncStatus.textContent = `${label}已保存到本机，可点击“上传云端”保存到云端。`;
  }

  const saveError = (reason: unknown) => reason instanceof Error ? reason.message : '保存失败，请重试。';

  const storedSyncKey = localStorage.getItem(SYNC_KEY_STORAGE);
  syncInput.value = storedSyncKey || `${crypto.randomUUID()}${crypto.randomUUID().replaceAll('-', '')}`;
  if (!storedSyncKey) localStorage.setItem(SYNC_KEY_STORAGE, syncInput.value);
  syncInput.addEventListener('input', () => localStorage.setItem(SYNC_KEY_STORAGE, syncInput.value.trim()));
  document.querySelector('#copy-sync-key')!.addEventListener('click', async () => {
    await navigator.clipboard.writeText(syncInput.value.trim());
    syncStatus.textContent = '同步密钥已复制。';
  });
  const uploadButton = document.querySelector('#upload-records') as HTMLButtonElement;
  const pullButton = document.querySelector('#pull-records') as HTMLButtonElement;
  const runCloudAction = async (direction: 'upload' | 'pull') => {
    const token = syncInput.value.trim();
    if (token.length < 16) { syncStatus.textContent = '同步密钥至少需要 16 位。'; return; }
    uploadButton.disabled = pullButton.disabled = true;
    syncStatus.textContent = direction === 'upload' ? '正在上传云端…' : '正在拉取云端…';
    try {
      if (direction === 'upload') {
        const result = await uploadAll(token);
        syncStatus.textContent = result.skipped.length ? '上传完成；部分云端记录更新，本次未覆盖。本机数据未改变。' : '上传完成，本机数据未改变。';
      } else {
        await pullAll(token);
        selectedGroupIds.clear();
        render();
        await updateQuotes();
        syncStatus.textContent = '拉取完成，已安全合并到本机，未上传本机数据。';
      }
    } catch (error) {
      syncStatus.textContent = saveError(error);
    } finally {
      uploadButton.disabled = pullButton.disabled = false;
    }
  };
  uploadButton.addEventListener('click', () => { void runCloudAction('upload'); });
  pullButton.addEventListener('click', () => { void runCloudAction('pull'); });

  filterBar.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-group]');
    if (!button) return;
    const id = button.dataset.group!;
    if (!id) selectedGroupIds.clear();
    else if (selectedGroupIds.has(id)) selectedGroupIds.delete(id);
    else selectedGroupIds.add(id);
    render();
  });

  const addDialog = document.querySelector('#add-dialog') as HTMLDialogElement;
  const addForm = document.querySelector('#add-form') as HTMLFormElement;
  const addGroupSelect = document.querySelector('#add-group') as HTMLSelectElement | null;
  const showAddDialog = () => {
    addForm.reset();
    if (addGroupSelect) {
      const groups = groupsOf();
      addGroupSelect.innerHTML = `<option value="">未分组</option>${groups.map(g => `<option value="${attr(g.id)}">${escapeHtml(g.name)}</option>`).join('')}`;
      addGroupSelect.value = '';
    }
    (document.querySelector('#add-error') as HTMLElement).textContent = '';
    openDialog(addDialog);
    (document.querySelector('#add-code') as HTMLInputElement).focus();
  };
  document.querySelector('#add-watch')!.addEventListener('click', showAddDialog);
  addForm.addEventListener('submit', event => {
    event.preventDefault();
    const code = (document.querySelector('#add-code') as HTMLInputElement).value.trim();
    const name = (document.querySelector('#add-name') as HTMLInputElement).value.trim();
    const groupId = (document.querySelector('#add-group') as HTMLSelectElement | null)?.value.trim() ?? '';
    const error = document.querySelector('#add-error') as HTMLElement;
    if (!/^\d{6}$/.test(code)) { error.textContent = '请输入 6 位代码。'; return; }
    const hasGrid = readGridRecords().some(item => item.row.code.trim() === code);
    try {
      if (!hasGrid) addWatch(code, name);
      if (groupId) setMemberships(code, [groupId]);
      closeDialog(addDialog);
      render();
      void updateQuotes();
      if (!hasGrid) void saveLocalChanges('观察标的');
      else {
        syncStatus.textContent = '该标的已有网格，已在复盘池中。';
        if (groupId) void saveLocalChanges('分组设置');
      }
    } catch (reason) {
      error.textContent = reason instanceof Error ? reason.message : '添加失败。';
    }
  });

  const noteDialog = document.querySelector('#note-dialog') as HTMLDialogElement;
  const noteCode = document.querySelector('#note-code') as HTMLInputElement;
  const noteDate = document.querySelector('#note-date') as HTMLInputElement;
  const noteFields = {
    emotion: document.querySelector('#note-emotion') as HTMLSelectElement,
    conclusion: document.querySelector('#note-conclusion') as HTMLSelectElement,
    action: document.querySelector('#note-action') as HTMLSelectElement,
    risk: document.querySelector('#note-risk') as HTMLTextAreaElement,
    remark: document.querySelector('#note-remark') as HTMLTextAreaElement,
  };
  function renderNotePremium() {
    const premium = readMeta().dailyPremiums?.[noteKey(noteCode.value, noteDate.value)];
    const output = document.querySelector('#note-premium') as HTMLOutputElement;
    output.value = premium ? `${premium.rate > 0 ? '+' : ''}${premium.rate.toFixed(2)}%` : '—';
    output.dataset.tone = !premium || premium.rate === 0 ? 'neutral' : premium.rate > 0 ? 'up' : 'down';
    output.title = premium ? `${premium.quoteDate} 腾讯行情${premium.referenceNav ? `；参考净值 ${premium.referenceNav}` : ''}` : '暂无该日溢价记录';
  }
  const loadNote = () => {
    renderNotePremium();
    const note = readMeta().notes[noteKey(noteCode.value, noteDate.value)];
    for (const [field, input] of Object.entries(noteFields)) input.value = note?.[field as keyof DailyNote] ?? '';
  };
  noteDate.addEventListener('change', loadNote);
  const showNoteDialog = (code: string, date = marketToday()) => {
    noteCode.value = code;
    noteDate.value = date;
    (document.querySelector('#note-title') as HTMLElement).textContent = `${code} 每日笔记`;
    (document.querySelector('#note-status') as HTMLElement).textContent = '';
    loadNote();
    openDialog(noteDialog);
  };
  (document.querySelector('#note-form') as HTMLFormElement).addEventListener('submit', async event => {
    event.preventDefault();
    const status = document.querySelector('#note-status') as HTMLElement;
    try {
      upsertDailyNote(noteCode.value, noteDate.value, {
        emotion: noteFields.emotion.value as DailyNote['emotion'],
        conclusion: noteFields.conclusion.value as DailyNote['conclusion'],
        action: noteFields.action.value as DailyNote['action'],
        risk: noteFields.risk.value.trim(),
        remark: noteFields.remark.value.trim(),
      });
      render();
      await saveLocalChanges('每日笔记');
      closeDialog(noteDialog);
    } catch (reason) {
      status.textContent = saveError(reason);
    }
  });

  const membershipDialog = document.querySelector('#membership-dialog') as HTMLDialogElement;
  const membershipCode = document.querySelector('#membership-code') as HTMLInputElement;
  const membershipOptions = document.querySelector('#membership-options') as HTMLElement;
  const showMembershipDialog = (code: string) => {
    const meta = readMeta();
    membershipCode.value = code;
    (document.querySelector('#membership-title') as HTMLElement).textContent = `${code} 编辑分组`;
    (document.querySelector('#membership-status') as HTMLElement).textContent = '';
    const checked = new Set(meta.memberships[code] ?? []);
    membershipOptions.innerHTML = groupsOf().map(group => `<label><input type="checkbox" value="${attr(group.id)}" ${checked.has(group.id) ? 'checked' : ''}>${escapeHtml(group.name)}</label>`).join('') || '<p class="muted">暂无分组，请先管理分组。</p>';
    openDialog(membershipDialog);
  };
  (document.querySelector('#membership-form') as HTMLFormElement).addEventListener('submit', async event => {
    event.preventDefault();
    const ids = [...membershipOptions.querySelectorAll<HTMLInputElement>('input:checked')].map(input => input.value);
    const status = document.querySelector('#membership-status') as HTMLElement;
    try {
      setMemberships(membershipCode.value, ids);
      render();
      await saveLocalChanges('分组');
      closeDialog(membershipDialog);
    } catch (reason) {
      status.textContent = saveError(reason);
    }
  });

  container.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    if (target.closest('#empty-add')) { showAddDialog(); return; }
    const button = target.closest<HTMLButtonElement>('[data-action]');
    const row = target.closest<HTMLTableRowElement>('tr[data-code]');
    if (!button || !row?.dataset.code) return;
    const code = row.dataset.code;
    if (button.dataset.action === 'move-up' || button.dataset.action === 'move-down') {
      const section = row.closest<HTMLElement>('[data-group-id]');
      if (!section) return;
      const codes = [...section.querySelectorAll<HTMLTableRowElement>('tr[data-code]')].map(item => item.dataset.code!);
      try {
        moveGroupCode(section.dataset.groupId!, codes, code, button.dataset.action === 'move-up' ? -1 : 1);
        render();
        const movedRow = [...container.querySelectorAll<HTMLTableRowElement>('tr[data-code]')].find(item => item.dataset.code === code && item.closest<HTMLElement>('[data-group-id]')?.dataset.groupId === section.dataset.groupId);
        movedRow?.querySelector<HTMLButtonElement>(`[data-action="${button.dataset.action}"]:not(:disabled)`)?.focus({ preventScroll: true });
        void saveLocalChanges('标的顺序').catch(reason => { syncStatus.textContent = saveError(reason); });
      } catch (reason) { syncStatus.textContent = saveError(reason); }
      return;
    }
    if (button.dataset.action === 'note') showNoteDialog(code, button.dataset.date);
    if (button.dataset.action === 'groups') showMembershipDialog(code);
    if (button.dataset.action === 'remove' && confirm(`确认移出标的 ${code}？该标的的历史笔记会保留。`)) {
      const gridRec = recordByCode(code);
      if (gridRec) removeRecords([gridRec.id]);
      removeWatch(code);
      render();
      void saveLocalChanges('观察标的');
    }
  });

  const groupsDialog = document.querySelector('#groups-dialog') as HTMLDialogElement;
  const groupsEditor = document.querySelector('#groups-editor') as HTMLElement;
  let editingGroups: ReviewGroup[] = [];
  const renderGroupsEditor = () => {
    groupsEditor.innerHTML = editingGroups.map((group, index) => {
      const catalog = isCatalogGroupId(group.id);
      const badge = catalog ? '<span class="catalog-badge">清单</span>' : '';
      const del = catalog ? '' : '<button class="danger" data-delete type="button">删除</button>';
      return `<div class="group-edit-row" data-id="${attr(group.id)}">${badge}<input value="${attr(group.name)}" maxlength="20" aria-label="分组名称"><button data-move="-1" type="button" ${index === 0 ? 'disabled' : ''}>↑</button><button data-move="1" type="button" ${index === editingGroups.length - 1 ? 'disabled' : ''}>↓</button>${del}</div>`;
    }).join('');
  };
  document.querySelector('#manage-groups')!.addEventListener('click', () => {
    editingGroups = groupsOf().map(group => ({ ...group }));
    (document.querySelector('#groups-status') as HTMLElement).textContent = '';
    renderGroupsEditor();
    openDialog(groupsDialog);
  });
  document.querySelector('#new-group')!.addEventListener('click', () => {
    editingGroups.push({ id: `g-${crypto.randomUUID()}`, name: `分组 ${editingGroups.length + 1}`, order: editingGroups.length });
    renderGroupsEditor();
  });
  groupsEditor.addEventListener('input', event => {
    const row = (event.target as HTMLElement).closest<HTMLElement>('[data-id]');
    if (row) editingGroups.find(group => group.id === row.dataset.id)!.name = (event.target as HTMLInputElement).value;
  });
  groupsEditor.addEventListener('click', event => {
    const target = event.target as HTMLElement;
    const row = target.closest<HTMLElement>('[data-id]');
    if (!row) return;
    const index = editingGroups.findIndex(group => group.id === row.dataset.id);
    if (target.closest('[data-delete]')) {
      if (isCatalogGroupId(editingGroups[index].id)) return;
      editingGroups.splice(index, 1);
      renderGroupsEditor();
      return;
    }
    const move = Number(target.closest<HTMLButtonElement>('[data-move]')?.dataset.move);
    if (move && editingGroups[index + move]) {
      [editingGroups[index], editingGroups[index + move]] = [editingGroups[index + move], editingGroups[index]];
      renderGroupsEditor();
      return;
    }
  });
  (document.querySelector('#groups-form') as HTMLFormElement).addEventListener('submit', async event => {
    event.preventDefault();
    const names = editingGroups.map(group => group.name.trim());
    const status = document.querySelector('#groups-status') as HTMLElement;
    if (!editingGroups.length) { status.textContent = '至少保留一个分组。'; return; }
    if (names.some(name => !name)) { status.textContent = '分组名称不能为空。'; return; }
    if (new Set(names).size !== names.length) { status.textContent = '分组名称不能重复。'; return; }
    try {
      const meta = readMeta();
      const catalogGroups = meta.groups.filter(group => isCatalogGroupId(group.id));
      const editedIds = new Set(editingGroups.map(group => group.id));
      for (const group of catalogGroups) {
        if (!editedIds.has(group.id)) editingGroups.push({ ...group });
      }
      const kept = new Set(editingGroups.map(group => group.id));
      const memberships = Object.fromEntries(Object.entries(meta.memberships).map(([code, ids]) => [code, ids.filter(id => kept.has(id))]));
      const now = new Date().toISOString();
      const deletedGroups = { ...meta.deletedGroups };
      for (const group of meta.groups) {
        if (kept.has(group.id) || isCatalogGroupId(group.id)) continue;
        deletedGroups[group.id] = now;
      }
      for (const group of catalogGroups) delete deletedGroups[group.id];
      writeMeta({ ...meta, groups: editingGroups.map((group, order) => ({ ...group, name: group.name.trim(), order, updatedAt: now })), memberships, deletedGroups, workspaceUpdatedAt: now, updatedAt: now });
      render();
      await saveLocalChanges('分组设置');
      closeDialog(groupsDialog);
    } catch (reason) {
      status.textContent = saveError(reason);
    }
  });

  for (const dialog of dialogs) {
    dialog.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('.dialog-close')) closeDialog(dialog);
      if (event.target === dialog) closeDialog(dialog);
    });
  }

  migrateUngroupedToHeld();
  syncFocusToRegular();
  render();
  void updateQuotes();
</script>

