---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/url';

const savedUrl = href('lab/grid-trading/saved');
const etfReviewUrl = href('lab/etf-review');
---

<Base title="网格回测详情" current="lab" description="网格回测的历史成交明细">
  <header class="hero compact-hero"><p class="kicker">BACKTEST DETAIL</p><h1 id="title">回测详情</h1><p id="subtitle" class="lede">正在读取已保存记录…</p></header>
  <div class="back-row">
    <a class="back" id="back-link" href={savedUrl}>← 网格列表</a>
    <a class="back" href={etfReviewUrl}>ETF 复盘</a>
  </div>
  <section class="plan-card" aria-label="回测分组、对应方案与波段交易统计">
    <div id="plan-tags" class="plan-tags" hidden></div>
    <div id="plan-stats" class="plan-stats" hidden></div>
  </section>
  <section id="stats" class="stats"></section>
  <section class="chart-panel">
    <div class="chart-head"><div><h2>资金与收盘价变化曲线</h2><p>当前标的的历史回测数据；上图价格、下图资金，共用同一条时间轴；日K 上可叠加 10 / 20 日均线；勾选 MACD / 波段顶底会在价格图下方加副图（只用于观察，不参与回测）</p></div><div class="legend axis-legend"><div class="legend-row"><b class="axis-tag tag-price">上图 · 价格</b><span class="kline-swatch up"></span>涨 <span class="kline-swatch down"></span>跌 <span class="zone-swatch support"></span>支撑区间 <span class="zone-swatch resistance"></span>压力区间（★ 越多越强） <span class="line fib-sw-retr"></span>斐波那契回撤 <span class="line fib-sw-ext"></span>延长线 <span class="line buy-level"></span>预计买入 <span class="line sell-level"></span>预计卖出</div><div class="legend-row"><b class="axis-tag tag-money">下图 · 资金</b><span class="line position"></span>持仓市值 <span class="line capital"></span>占用本金 <span class="line profit"></span>总盈亏</div></div></div>
    <div class="range-bar" id="range-bar" aria-label="曲线时间区间">
      <div class="range-presets" role="group" aria-label="快捷区间">
        <button type="button" data-range="3">近三个月</button><button type="button" data-range="6">近半年</button><button type="button" data-range="12">近 1 年</button><button type="button" data-range="36">近 3 年</button><button type="button" data-range="60">近 5 年</button><button type="button" data-range="all" class="active">全部</button>
      </div>
      <label>起 <input id="range-from" type="date"></label><label>止 <input id="range-to" type="date"></label>
      <span id="range-note" class="range-note" hidden></span>
    </div>
    <div class="view-bar" aria-label="叠加内容显示">
      <span>显示：</span>
      <label><input id="view-levels" type="checkbox" checked> 手动支撑压力</label>
      <label><input id="view-fib" type="checkbox"> 斐波那契</label>
      <label id="view-grid-label"><input id="view-grid" type="checkbox" checked> 预计买卖线</label>
      <label><input id="view-ma10" type="checkbox" checked> 10 日线</label>
      <label><input id="view-ma20" type="checkbox" checked> 20 日线</label>
      <label><input id="view-volume" type="checkbox" checked> 成交量</label>
      <label><input id="view-macd" type="checkbox"> MACD</label>
      <label><input id="view-band" type="checkbox"> 波段顶底</label>
      <label hidden title="创业板 ETF（159915）÷ 红利 ETF（510880）前复权收盘比值，与其 20 日均线比较：上方偏进攻，下方偏防守（金叉不买）；2011 年起"><input id="view-r2" type="checkbox"> 创业板择时</label>
      <label hidden title="沪深300 指数 ÷ 红利 ETF（510880）前复权收盘比值，与其 20 日均线比较：上方偏进攻，下方偏防守（金叉不买）；K 线图上偏防守日期铺蓝底"><input id="view-h1" type="checkbox"> 沪深300择时</label>
      <label hidden title="MACD(12,26,9)：空仓金叉→次日开盘买，持仓死叉→当日收盘卖；指标用上市以来前复权日线计算，前 120 根只预热"><input id="view-macd-trades" type="checkbox"> MACD收盘卖买卖点 <span class="macd-sw buy">▲</span>买 <span class="macd-sw sell">▼</span>卖</label>
      <label hidden title="择时为牛市（创业板÷红利 在 20 日均线上方）时：MACD 金叉，或收盘站上 10 日线且 KDJ 的 K−D ≥ 5.3 → 次日开盘买；熊市不开新仓。持仓时 MACD 死叉，或择时为熊市时收盘跌破 10 日线（牛市跌破不卖） → 当日收盘卖（买入当天不能卖则次日开盘卖）。用上市以来前复权日线，前 120 根只预热"><input id="view-kd10-trades" type="checkbox"> 创业板择时买卖点 <span class="macd-sw kbuy">▲</span>买 <span class="macd-sw ksell">▼</span>卖</label>
      <label hidden title="沪深300择时为牛市（沪深300÷红利 在 20 日均线上方）时 MACD(12,26,9) 金叉 → 次日开盘买；熊市不开新仓；持仓死叉 → 当日收盘卖（买入当天不能卖则次日开盘卖）。用上市以来前复权日线，前 120 根只预热"><input id="view-h1-trades" type="checkbox"> 沪深300择时买卖点 <span class="macd-sw hbuy">▲</span>买 <span class="macd-sw hsell">▼</span>卖</label>
      
    </div>
    <div class="chart-stage"><div id="price-estimate" class="price-estimate" hidden></div><div class="chart-scroll"><svg id="equity-chart" viewBox="0 0 920 300" role="img" aria-label="当前标的的资金与收盘价变化曲线"><text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">读取已保存回测数据后显示曲线</text></svg></div></div>
    <section class="levels-panel" id="levels-panel" aria-label="支撑与压力区间">
      <div class="levels-head"><h3>支撑 / 压力区间</h3><span>数量自己增减（每侧最多 10 个），可设强度（弱 / 中 / 强，越强色带越深、边线越粗），只用于在价格图上显示，不参与回测；全空的行保存时忽略；只有一个价位时，下沿和上沿填同一个价格</span></div>
      <div class="levels-grid">
        {(['support', 'resistance'] as const).map(kind => (
          <div class={`levels-col ${kind}`}>
            <h4>{kind === 'support' ? '支撑区间' : '压力区间'}</h4>
            <div class="level-rows" data-kind={kind}></div>
            <button type="button" class="level-add" data-kind={kind}>+ 添加{kind === 'support' ? '支撑' : '压力'}区间</button>
          </div>
        ))}
      </div>
      <div class="levels-actions"><button id="levels-save" class="levels-btn" type="button">保存区间</button><button id="levels-clear" class="tool-link" type="button">清空</button><span id="levels-note" class="levels-note" hidden></span></div>
    </section>
    <section class="levels-panel fib-panel" id="fib-panel" aria-label="斐波那契">
      <div class="levels-head"><h3>斐波那契回撤 / 延长线</h3><span>可以直接填价格，也可以只填起点、终点两个日期、价格留空：程序自动判断哪天是高点（取当天最高价）、哪天是低点（取当天最低价）；上涨波段起点是低点、终点是高点，下跌波段反过来。回撤位 0.236 / 0.382 / 0.5 / 0.618 / 0.786 始终显示，延长线可选；只用于在价格图上显示，不参与回测</span></div>
      <div class="fib-sets">
        <label>设置 <select id="fib-set" aria-label="选择斐波那契设置"></select></label>
        <input id="fib-name" type="text" maxlength="12" placeholder="名称" aria-label="本组名称">
        <div class="fib-buttons"><button id="fib-confirm" class="tool-button" type="button">确认（图中显示）</button><button id="fib-save" class="levels-btn" type="button">保存到云端</button></div>
        <button id="fib-new" class="tool-button" type="button">＋ 新增一组</button>
        <button id="fib-delete" class="tool-link" type="button">删除此组</button>
      </div>
      <div class="fib-form">
        <div class="fib-point"><b>起点</b><input id="fib-start-date" type="date" aria-label="起点日期"><input id="fib-start-price" type="number" step="0.001" min="0" inputmode="decimal" placeholder="价格（可留空）" aria-label="起点价格"></div>
        <div class="fib-point"><b>终点</b><input id="fib-end-date" type="date" aria-label="终点日期"><input id="fib-end-price" type="number" step="0.001" min="0" inputmode="decimal" placeholder="价格（可留空）" aria-label="终点价格"></div>
        <div class="fib-ext"><span>延长线</span><label><input type="checkbox" name="fib-ext" value="1.272" checked> 1.272</label><label><input type="checkbox" name="fib-ext" value="1.382" checked> 1.382</label><label><input type="checkbox" name="fib-ext" value="1.618" checked> 1.618</label></div>
      </div>
      <div class="levels-actions"><span id="fib-note" class="levels-note" hidden></span></div>
    </section>
  </section>
  <section class="minute-panel" aria-label="分钟线">
    <div class="minute-head">
      <div><h2>分钟线</h2><p id="minute-status">云端每个交易日收盘后自动抓取 1 分钟线，需要已填写同步密钥。</p></div>
      <div class="minute-controls"><label>日期 <select id="minute-date"></select></label><label class="minute-check"><input id="minute-adjust" type="checkbox" checked> 前复权</label></div>
    </div>
    <p class="minute-alert" id="minute-alert" hidden></p>
    <div class="minute-summary" id="minute-summary"></div>
    <div class="chart-scroll"><svg id="minute-chart" viewBox="0 0 920 360" role="img" aria-label="分钟价格与成交量"></svg></div>
  </section>
  <section class="backup-panel" aria-label="备份对比">
    <div class="backup-head">
      <div><h2>备份对比</h2><p id="backup-desc">备份当前数据作为基准点。之后你手动微调买卖点（改成交、增删记录、改参数），这里会对比“从备份点起完全按网格买卖”与“你现在的实际数据”的收益差别。</p></div>
      <div class="backup-actions"><select id="backup-select" hidden aria-label="选择备份"></select><a id="backup-view" class="tool-link" hidden>查看备份详情</a><button id="backup-delete" class="tool-link" type="button" hidden>删除此备份</button></div>
    </div>
    <p id="backup-empty" class="backup-empty">还没有备份。点击下方“历史成交”里的“备份当前数据”，以当前状态为起点开始对比。</p>
    <div id="backup-compare" class="backup-compare"></div>
    <div id="compare-chart-block" class="compare-chart-block" hidden>
      <div class="chart-head">
        <div><h3>对比曲线</h3><p>同一指标下，纯网格续跑与当前数据（含手动微调）的走势对比；虚线竖线为备份点，悬停可查看两者的值和差额。</p></div>
        <div class="metric-tabs" role="tablist" aria-label="对比指标"><button type="button" class="active" data-metric="pnl">总盈亏</button><button type="button" data-metric="positionValue">持仓市值</button><button type="button" data-metric="capitalUsed">占用本金</button></div>
      </div>
      <div class="legend"><span class="line pure"></span>纯网格续跑（本备份，含备份视图中的成交修正）<span class="line live"></span>当前数据（含手动微调）</div>
      <div class="chart-scroll"><svg id="compare-chart" viewBox="0 0 920 300" role="img" aria-label="备份与当前数据对比曲线"></svg></div>
    </div>
  </section>
  <section class="history"><h2>历史成交</h2><p id="history-hint">成交价格、成交金额、成交份额可直接修改为真实成交值（如按 100 份整数倍成交），修改份额时金额按“份额 × 成交价”计算；修改后该笔及之后的持仓、盈亏、网格价位会重新计算，并自动同步到云端。持仓市值按该笔成交价估值；“当时占用本金”仅统计成交金额，不含手续费，其最高值与回测摘要中的“最多使用本金”一致。最新成交在最上方。</p>
    <p id="history-hint2">可添加或删除成交记录（建仓不可删除）：添加时填写日期、方向、成交价格和成交份额，其余数据自动计算并按日期排入列表。增删只影响总盈亏、持仓和占用本金，不改动其他成交行；只有最上面（最新）的一条变化时（新增了更新的成交，或删掉了最新的成交），才会改变下一格买卖价的基准，并且该条之后的交易日会按网格从它的成交价重新判断，之后被删除过的成交日视为当天没有成交。</p>
    <div class="trade-tools"><button id="add-trade-toggle" class="tool-button" type="button">＋ 添加记录</button><button id="backup-now" class="tool-button" type="button" disabled>备份当前数据</button><button id="restore-removed" class="tool-link" type="button" hidden></button></div>
    <section id="removed-panel" class="removed-panel" hidden aria-label="已删除的网格成交">
      <div class="removed-head"><strong id="removed-title">已删除的网格成交</strong><button id="removed-close" class="tool-link" type="button">收起</button></div>
      <div class="scroll"><table class="removed-table">
        <thead><tr><th><input id="removed-all" type="checkbox" aria-label="全选"></th><th>日期</th><th>方向</th><th>价格</th><th>份额</th><th>金额</th><th>状态</th></tr></thead>
        <tbody id="removed-rows"></tbody>
      </table></div>
      <div class="removed-actions">
        <button id="removed-restore-selected" class="tool-primary" type="button" disabled>恢复选中</button>
        <button id="removed-clear-selected" class="tool-button danger" type="button" disabled>清除选中</button>
        <button id="removed-restore-all" class="tool-button" type="button">恢复全部</button>
        <button id="removed-clear-stale" class="tool-button danger" type="button" hidden>清除失效记录</button>
        <button id="removed-toggle-hidden" class="tool-link" type="button" hidden></button>
        <span id="removed-msg" class="removed-msg" role="status"></span>
      </div>
      <p class="removed-hint">“已失效”指在当前规则和行情下，这一天已经没有对应的网格成交（例如规则变化后日期对不上）；失效记录不影响任何成交行，可以用“清除选中”或“清除失效记录”清掉。对“可恢复”的条目，“清除选中”只是把它从这个待处理列表里移走，成交仍然保持删除（可以随时用“显示已确认删除”找回）。</p>
    </section>
    <form id="trade-form" class="trade-form" hidden novalidate>
      <label>日期 <input id="tf-date" type="date" required></label>
      <label>方向 <select id="tf-side"><option value="买入">买入</option><option value="卖出">卖出</option></select></label>
      <label>成交价格 <input id="tf-price" type="number" step="0.001" min="0.001" inputmode="decimal" required></label>
      <label>成交份额 <input id="tf-shares" type="number" step="100" min="1" inputmode="decimal" required></label>
      <span id="tf-preview" class="tf-preview">成交金额 —</span>
      <button id="tf-save" class="tool-primary" type="submit">保存</button>
      <button id="tf-cancel" class="tool-button" type="button">取消</button>
      <span id="tf-error" class="tf-error" role="alert"></span>
    </form>
    <p id="sync-note" class="sync-note" role="status" hidden></p><div class="table-shell"><table class="detail-table"><thead><tr><th>日期</th><th>操作</th><th>成交价格</th><th>成交金额</th><th>成交份额</th><th>成交后持仓份额</th><th>成交后持仓市值</th><th>当时占用本金</th><th>当时总盈亏</th><th>操作</th></tr></thead><tbody id="trades"></tbody></table></div></section>
</Base>

<script>
  import {
    calculateGrid, adjustmentsOf, getCandles, getHfqCandles, fetchQuotes, mergeQuote, mergeQuoteByChange, refreshRecord, readRecords, saveRecord, pushRecord, pullRecord, recordByCode, pullByCode, newWatchRecord, watchIdOf,
    renderEquityChart, renderCompareChart, parseLevels, normalizeLevels, parseFib, fibFromDates, normalizeFibSets, normalizeView, MAX_FIB_SETS, type FibSet, MAX_LEVELS, type Candle, type Levels, type Fib, type View, holdingValue, openingOf, createBackup, replayBackup, refreshBackupSnapshot, upgradeBackup, formatMoney, formatAmount, formatPercent, tick,
    blockCopy, fetchMinuteBars, fetchLatestMinuteBars, syncMinuteBars, fetchMinuteStatus, readSyncKey, marketToday, type MinuteBar, type ChartIndicators, type RatioPanels,
    type SavedRecord, type Trade, type Adjustments, type GridResult, type Backup, type CompareMetric, type EquityPoint,
  } from '../../../lib/grid-trading';
  import { renderMinuteChart, minuteSummaryHtml } from '../../../lib/minute-chart';
  import { H1_CODES, isLiveBar, macdEstimate, maEstimate, R2_CODES, ratioEstimate, styleRatio } from '../../../lib/chart-indicators';
  import { panViewport, zoomViewport, type Viewport } from '../../../lib/chart-viewport';
  import { planTagsOf } from '../../../lib/backtest-plan-tags';
  import { backtestPlan, backtestPlanYearly, cybPlan, hsPlan, macdPlan, planStats, planTrades, yearlySummary, type PlanBacktest, type PlanKey, type PlanResult } from '../../../lib/plan-trades';
  import { bullLookup } from '../../../lib/kd10-signals';
  import { SYNC_ENDPOINT } from '../../../lib/endpoints';

  blockCopy(); // 屏蔽页面内容复制

  type AdjustField = 'price' | 'amount' | 'shares';
  const id = new URLSearchParams(location.search).get('id');
  // 备份视图：详情页加 backup 参数即进入只读的备份视图，展示备份时的数据以及备份日之后完全按网格买卖的走向。
  const backupParam = new URLSearchParams(location.search).get('backup');
  let viewBackup: Backup | undefined;
  // 对比曲线：live 为当前数据（含手动微调）的逐日曲线，pure 为备份视图的纯网格续跑曲线。
  let liveSeries: EquityPoint[] = [], pureSeries: EquityPoint[] = [], compareMetric: CompareMetric = 'pnl', compareBackup: Backup | undefined;
  let viewLiveResult: GridResult | undefined;

  // ---------- 资金与K线曲线：时间区间 ----------
  // 区间与建仓日无关：默认「全部」= 标的上市以来到最新；早于建仓日的那段日线只用于显示（不参与回测）。
  // 「全部」用一个足够早的起点去取日线，实际起点由下面夹到第一根日线（即上市日或行情源能给到的最早一天）。
  type ChartInput = { series: EquityPoint[]; nextBuy: number; nextSell: number; trades: Trade[]; marker?: { date: string; label: string }; gridStep: { down: number; up: number }; code: string; openDate: string; levels?: Levels; fib?: Fib; view?: View; watch?: boolean };
  let chartInput: ChartInput | undefined;
  let chartCandles: { code: string; begin: string; candles: Candle[] } | undefined;
  const ALL_FROM = '1990-01-01';
  let rangeFrom: string | undefined = ALL_FROM, rangeTo: string | undefined, rangeKey = 'all', chartRun = 0;
  const equitySvg = document.querySelector('#equity-chart') as SVGSVGElement;
  const rangeFromInput = document.querySelector('#range-from') as HTMLInputElement;
  const rangeToInput = document.querySelector('#range-to') as HTMLInputElement;
  const rangeNote = document.querySelector('#range-note') as HTMLElement;
  const showRangeNote = (text: string) => { rangeNote.textContent = text; rangeNote.hidden = !text; };
  const monthsBefore = (date: string, months: number) => { const day = new Date(`${date}T00:00:00Z`); day.setUTCMonth(day.getUTCMonth() - months); return day.toISOString().slice(0, 10); };

  // 手动区间缺省显示；斐波那契缺省在已配置时显示。
  // 副图指标开关只存在本机（不写入云端记录）；指标需要预热数据，勾选时多取区间起点前 6 个月的日线参与计算、不显示。
  const INDICATOR_KEY = 'grid-detail-indicators';
  const readIndicators = (): ChartIndicators => { try { return JSON.parse(localStorage.getItem(INDICATOR_KEY) ?? '{}') ?? {}; } catch { return {}; } };
  // 10 / 20 日均线默认显示（没存过对应设置时）
  let indicators: ChartIndicators = { ma10: true, ma20: true, volume: true, ...readIndicators() };
  const shown = (input: ChartInput) => ({ levels: input.view?.levels !== false, fib: input.view?.fib ?? !!input.fib, grid: !input.watch && input.view?.grid !== false });
  // MACD 金叉 / 死叉、10 日线跌破 / 站上预估：不依赖图上开关，始终显示在图上方。盘中按昨收后的状态估今天收盘，收盘后估下一交易日。
  const priceEstimate = document.querySelector('#price-estimate') as HTMLElement;
  function showMacdEstimate(candles: Candle[]) {
    const live = isLiveBar(candles.at(-1)?.date);
    const pct = (gap: number) => `${gap >= 0 ? '+' : ''}${gap.toFixed(2)}%`;
    const gapOf = (price: number, last: number) => pct((price / last - 1) * 100);
    const when = marketPhase(candles.at(-1)?.date) === 'post' ? '下一交易日收盘' : '今日收盘';
    // MACD 交叉与 10 日线穿越的临界价，浮在价格图左上角，不再占文字行。
    const overlay: string[] = [];
    const est = macdEstimate(candles, live);
    if (est) overlay.push(`<div class="${est.bull ? 'bear' : 'bull'}"><i class="pe-sw macd"></i><span>${est.bull ? 'MACD死叉' : 'MACD金叉'}</span><b>${est.bull ? '<' : '>'} ${est.price.toFixed(3)}</b><em>${gapOf(est.price, est.lastClose)}</em></div>`);
    const ma = maEstimate(candles, 10, live);
    if (ma) overlay.push(`<div class="${ma.above ? 'bear' : 'bull'}"><i class="pe-sw ma10"></i><span>${ma.above ? '跌破10日线' : '站上10日线'}</span><b>${ma.above ? '<' : '>'} ${ma.price.toFixed(3)}</b><em>${gapOf(ma.price, ma.lastClose)}</em></div>`);
    priceEstimate.hidden = !overlay.length;
    priceEstimate.innerHTML = overlay.length ? `<div class="pe-head">${when}临界价</div>${overlay.join('')}` : '';
    renderPlanActions(candles, est, ma);
  }
  // 交易时段（北京时间）：盘中 = 今天的日线未收盘；盘前 = 工作日 15:00 前但还没有今天的日线（9:30 前，或实时行情没取到）；
  // 其余（收盘后、周末）算盘后。节假日按工作日判断，节假日白天会被当成盘前。
  function marketPhase(lastDate: string | undefined, now = new Date()): 'pre' | 'live' | 'post' {
    if (isLiveBar(lastDate, now)) return 'live';
    const bj = new Date(now.getTime() + 8 * 3600e3), today = bj.toISOString().slice(0, 10), day = bj.getUTCDay();
    return day >= 1 && day <= 5 && bj.getUTCHours() < 15 && (!lastDate || lastDate < today) ? 'pre' : 'post';
  }
  // 方案卡片状态行：① 择时——当前牛/熊，比值再涨/跌多少翻转；② 买卖——不看择时，只按 MACD（创业板方案再加 10 日线）算离下一个买点或卖点还差多少。
  function renderPlanActions(candles: Candle[], est: ReturnType<typeof macdEstimate>, ma: ReturnType<typeof maEstimate>) {
    const abs = (gap: number) => `${Math.abs(gap * 100).toFixed(2)}%`;
    const phase = marketPhase(candles.at(-1)?.date);
    const when = phase === 'post' ? '下一交易日收盘' : '今日收盘';
    const todayBar = candles.at(-1)?.date === new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
    const base = phase === 'live' ? '现价' : phase === 'pre' ? '昨收' : todayBar ? '今日收盘价' : '最新收盘价';
    const move = (price: number, last: number, label: string, sign: '<' | '>') => {
      const gap = price / last - 1;
      return `${gap >= 0 ? '涨' : '跌'} <b>${abs(gap)}</b>（${sign === '<' ? '&lt;' : '&gt;'} ${price.toFixed(3)}）${label}`;
    };
    const plans = allPlans(candles);
    for (const def of PLAN_DEFS) {
      const plan = plans.find(item => item.key === def.key);
      const points = def.key === 'cyb' ? ratioPoints.r2 : def.key === 'hs' ? ratioPoints.h1 : undefined;
      const ratio = points ? ratioEstimate(points, isLiveBar(points.at(-1)?.date)) : undefined;
      const timingSlot = planTagsBox.querySelector<HTMLElement>(`[data-plan-timing="${def.key}"]`);
      if (timingSlot) {
        if (ratio) {
          const gap = ratio.critical / ratio.ratio - 1;
          timingSlot.title = `${def.key === 'cyb' ? '创业板' : '沪深300'} ÷ 红利 = ${ratio.ratio.toFixed(4)}，20 日均线 ${ratio.ma.toFixed(4)}（${ratio.live ? '盘中' : `截至 ${ratio.date} 收盘`}）；收盘比值${ratio.bull ? '低于' : '高于'} ${ratio.critical.toFixed(4)} 翻转。`;
          timingSlot.innerHTML = `<span class="signal-label">市场择时</span><span class="est-tag ${ratio.bull ? 'bull' : 'bear'}">${ratio.bull ? '牛市' : '熊市'}</span>比值再${gap >= 0 ? '涨' : '跌'} <b>${abs(gap)}</b> 转${ratio.bull ? '熊' : '牛'}`;
        } else timingSlot.innerHTML = '';
      }
      const actionSlot = planTagsBox.querySelector<HTMLElement>(`[data-plan-action="${def.key}"]`);
      if (!actionSlot || !plan) continue;
      let text: string;
      if (plan.holding) {
        text = est?.bull ? `${when}${move(est.price, est.lastClose, 'MACD 死叉', '<')}，当日收盘卖` : 'MACD 已在空头，暂无死叉卖点';
      } else if (plan.pendingBuy) {
        const why = plan.pendingBuy.reason === '金叉' ? 'MACD 金叉' : '站上 10 日线';
        text = phase === 'live' ? `按现价今日收盘将${why}，收盘确认后次日开盘买`
          : phase === 'pre' ? `昨日已${why}，今日开盘买` : `${todayBar ? '今日' : '上一交易日'}已${why}，下一交易日开盘买`;
      } else {
        const parts: string[] = [];
        if (est && !est.bull) parts.push(move(est.price, est.lastClose, 'MACD 金叉', '>'));
        if (def.key === 'cyb' && ma && !ma.above) parts.push(move(ma.price, ma.lastClose, '站上 10 日线（且 K−D≥5.3）', '>'));
        text = parts.length ? `${when}${parts.join('，或')}，次日开盘买` : `MACD 已在多头，等下一次金叉${def.key === 'cyb' ? '或重新站上 10 日线' : ''}`;
      }
      actionSlot.title = `涨跌幅相对${base}计算`;
      actionSlot.innerHTML = `<span class="signal-label">买卖信号</span><span>${text}</span>`;
    }
  }
  // R2 风格比值：两只 ETF 的前复权日线 + 实时报价；失败时只是不显示，不影响主图。
  let ratioPoints: RatioPanels = {};
  let ratioBegin = '';
  async function loadRatios(begin: string) {
    if (ratioBegin && ratioBegin <= begin && ratioPoints.r2?.length && ratioPoints.h1?.length) return;
    const pairs = [['r2', R2_CODES], ['h1', H1_CODES]] as const;
    const quotes = await fetchQuotes(pairs.flatMap(([, codes]) => [codes.growth, codes.defensive])).catch(() => new Map());
    const next: RatioPanels = {};
    await Promise.all(pairs.map(async ([key, codes]) => {
      try {
        // 指数（sh/sz 前缀）不涉及分红复权；ETF 用后复权，与研究回测口径一致（前复权对分红多的红利 ETF 会扭曲比值）。
        const series = async (code: string) => /^(sh|sz)/.test(code)
          ? mergeQuote(await getCandles(code, begin), quotes.get(code))
          : mergeQuoteByChange(await getHfqCandles(code, begin), quotes.get(code));
        const [growth, defensive] = await Promise.all([series(codes.growth), series(codes.defensive)]);
        next[key] = styleRatio(growth, defensive);
      } catch { /* 单个比值取数失败只是不显示 */ }
    }));
    ratioPoints = next; ratioBegin = begin;
  }
  // 方案卡片：创业板择时 / 沪深300择时 / 纯MACD 三个方案始终显示；入选优选分组的标「优选」，全历史卡玛最高的高亮为「最优」。
  // 每个方案的勾选框控制图上买卖点（原工具栏的三个买卖点开关已隐藏，这里代为勾选），勾选时顺带打开对应择时底色。
  const planTagsBox = document.querySelector('#plan-tags') as HTMLElement;
  let planTagsCode = '';
  // rules：① 买入条件 ② 卖出条件（与 kd10Signals / macdCloseSignals 实现一致）
  const PLAN_DEFS: { key: PlanKey; name: string; timing: string; rules: [string, string]; trades: string; shade?: string }[] = [
    { key: 'cyb', name: '创业板择时', timing: '创业板 ÷ 红利，高于 20 日均线为牛', rules: ['牛市 MACD 金叉，或站上 10 日线且 K−D≥5.3，次日开盘买', 'MACD 死叉，或熊市跌破 10 日线，当日收盘卖'], trades: '#view-kd10-trades', shade: '#view-r2' },
    { key: 'hs', name: '沪深300择时', timing: '沪深300 ÷ 红利，高于 20 日均线为牛', rules: ['牛市 MACD 金叉，次日开盘买', 'MACD 死叉，当日收盘卖'], trades: '#view-h1-trades', shade: '#view-h1' },
    { key: 'macd', name: '纯MACD', timing: '不择时', rules: ['MACD(12,26,9) 金叉，次日开盘买', 'MACD 死叉，当日收盘卖'], trades: '#view-macd-trades' },
  ];
  function renderPlanTags(code: string) {
    if (planTagsCode === code) return;
    planTagsCode = code;
    const marks = new Map<PlanKey, string[]>();
    for (const tag of planTagsOf(code)) {
      const key: PlanKey = tag.views?.includes('kd10Trades') ? 'cyb' : 'hs';
      marks.set(key, [...(marks.get(key) ?? []), tag.name]);
    }
    planTagsBox.hidden = false;
    planTagsBox.innerHTML = PLAN_DEFS.map(def => `<div class="plan-tag" data-plan-block="${def.key}"><div class="plan-tag-head">`
      + `<h2 class="plan-chip">${def.name}</h2><span class="plan-best">卡玛最优</span>${(marks.get(def.key) ?? []).map(name => `<span class="plan-mark">${name}</span>`).join('')}`
      + `<label class="plan-check plan-alert-check"><input type="checkbox" data-plan-alert="${def.key}" disabled> Telegram 提醒</label>`
      + `<label class="plan-check"><input type="checkbox" data-plan-view="${def.key}"> 图上显示买卖点</label>`
      + `</div>`
      + `<div class="plan-tag-text"><div class="plan-status"><div class="plan-position"><span class="signal-label">当前持仓</span><span class="plan-hold" data-plan="${def.key}"></span></div>${def.key === 'macd' ? '' : `<div class="plan-timing" data-plan-timing="${def.key}"></div>`}<div class="plan-action" data-plan-action="${def.key}"></div></div>`
      + `<details class="plan-rules"><summary>择时规则<span>${def.timing}</span></summary><div class="plan-rule-grid"><div><span class="rule-label buy">买入条件</span><p>${def.rules[0]}</p></div><div><span class="rule-label sell">卖出条件</span><p>${def.rules[1]}</p></div></div></details></div>`
      + `<div class="plan-bt" data-plan-stats="${def.key}"></div></div>`).join('')
      + '<div class="plan-note">图上 ▲ 买 ▼ 卖，持仓期间连线：红赚绿亏。</div>';
    planTagsBox.querySelectorAll<HTMLInputElement>('[data-plan-view]').forEach(box => {
      const def = PLAN_DEFS.find(item => item.key === box.dataset.planView)!;
      const trades = document.querySelector(def.trades) as HTMLInputElement;
      box.checked = trades.checked;
      box.addEventListener('change', () => {
        trades.checked = box.checked;
        const shade = def.shade ? document.querySelector(def.shade) as HTMLInputElement | null : null;
        if (shade) shade.checked = box.checked; // 择时底色开关已隐藏，跟随方案卡片开关
        trades.dispatchEvent(new Event('change'));
      });
    });
    void loadAlertChoice(code);
  }
  // Telegram 择时提醒：每个标的最多选一个方案（三个勾选框互斥），存在同步服务里，14:45 / 15:15 的提醒按它发。
  // 没手动改过时 A / B / 行业观察池按所在分组的回测最优方案提醒，其他标的不提醒。
  const alertBoxes = () => [...planTagsBox.querySelectorAll<HTMLInputElement>('[data-plan-alert]')];
  function showAlertChoice(plan: string) {
    for (const box of alertBoxes()) box.checked = box.dataset.planAlert === plan;
  }
  async function loadAlertChoice(code: string) {
    const token = readSyncKey();
    if (!token) { for (const box of alertBoxes()) box.closest('label')!.title = '先在网格交易页设置同步密钥才能改提醒'; return; }
    try {
      const response = await fetch(`${SYNC_ENDPOINT}/plan-alert/choice?code=${encodeURIComponent(code)}`, { headers: { authorization: `Bearer ${token}` }, signal: AbortSignal.timeout(10000) });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const choice = await response.json() as { plan: string };
      if (planTagsCode !== code) return;
      showAlertChoice(choice.plan);
    } catch (error) { console.error('读取提醒方案失败', error); return; }
    for (const box of alertBoxes()) {
      box.disabled = false;
      box.addEventListener('change', async () => {
        const previous = alertBoxes().find(item => item !== box && item.checked)?.dataset.planAlert ?? (box.checked ? 'none' : box.dataset.planAlert!);
        const plan = box.checked ? box.dataset.planAlert! : 'none';
        showAlertChoice(plan);
        alertBoxes().forEach(item => { item.disabled = true; });
        try {
          const response = await fetch(`${SYNC_ENDPOINT}/plan-alert/choice`, {
            method: 'PUT', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },
            body: JSON.stringify({ code, name: nameParam || record?.name || code, plan }), signal: AbortSignal.timeout(10000),
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
        } catch (error) {
          console.error('保存提醒方案失败', error);
          showAlertChoice(previous);
          showNote('保存 Telegram 提醒失败，请稍后重试。');
        } finally { alertBoxes().forEach(item => { item.disabled = false; }); }
      });
    }
  }
  async function drawEquity() {
    const input = chartInput;
    if (!input) return;
    renderPlanTags(input.code);
    const run = ++chartRun;
    // 多取 6 个月日线作指标预热（MACD 预估始终显示，也需要预热），只显示区间内的部分
    // MACD收盘卖、择时+KD10 买卖点要与回测一致，需从上市起算指标（EMA 以首根收盘为初值），勾选时取全部历史日线
    // 方案卡片的回测统计与持仓状态始终要用上市以来的全部日线（EMA 以首根收盘为初值，与研究一致）
    const begin = '2000-01-01';
    try {
      // 已有的显示用日线起点不晚于需要的起点就复用（getCandles 本身还有按代码的本地缓存）。
      if (!chartCandles || chartCandles.code !== input.code || chartCandles.begin > begin) {
        const [main] = await Promise.all([getCandles(input.code, begin), loadRatios(begin < '2011-01-01' ? '2011-01-01' : begin)]);
        const candles = mergeQuote(main, (await fetchQuotes([input.code])).get(input.code));
        if (run !== chartRun) return;
        chartCandles = { code: input.code, begin, candles };
      }
    } catch {
      if (run !== chartRun) return;
      if (rangeFrom) { rangeFrom = undefined; rangeKey = 'open'; showRangeNote('更早的行情获取失败，已改为建仓日起'); void drawEquity(); return; }
      equitySvg.innerHTML = '<text x="460" y="150" text-anchor="middle" fill="#94a3b8" font-size="13">行情获取失败，暂时无法绘制曲线</text>';
      return;
    }
    renderChart();
  }
  // 用已取到的日线按当前区间同步重绘（拖动、缩放时逐帧调用，不发请求）。
  function renderChart() {
    const input = chartInput;
    if (!input || !chartCandles) return;
    const candles = chartCandles.candles;
    showMacdEstimate(candles);
    const latest = candles.at(-1)?.date ?? '', first = candles[0]?.date ?? '';
    // 请求的起点早于实际有行情的第一天（如标的上市较晚）：夹到第一根日线。
    if (rangeFrom && first && rangeFrom < first) rangeFrom = first;
    const from = rangeFrom ?? input.openDate;
    rangeFromInput.value = from; rangeToInput.value = rangeTo ?? latest;
    // 上限放到「今天」（北京时间）：盘前、休市或行情未更新时最新日线可能早于今天，但仍应能选到今天。
    const today = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
    rangeFromInput.max = rangeToInput.max = latest > today ? latest : today; rangeFromInput.min = rangeToInput.min = '2000-01-01'; // 不能用已加载日线的首日：那样只能选到建仓日，选更早的日期才会补拉行情；早于上市日的由上面夹到首日
    document.querySelectorAll<HTMLButtonElement>('.range-presets button').forEach(button => button.classList.toggle('active', button.dataset.range === rangeKey));
    const plans = renderEquityChart(equitySvg, input.series, input.nextBuy, input.nextSell, input.trades, input.marker, input.gridStep, candles, { from, to: rangeTo }, shown(input).levels ? input.levels : undefined, shown(input).fib ? input.fib : undefined, shown(input).grid, indicators, ratioPoints);
    void plans; // 图上勾选的方案只用于画买卖点；卡片统计固定算三个方案
    renderPlanStats(allPlans(candles), candles);
  }
  // 三个方案的连续信号（持仓状态用）：按日线与择时数据缓存，拖动缩放时不重算。
  let plansCache: { key: string; plans: PlanResult[] } | undefined;
  function allPlans(candles: Candle[]): PlanResult[] {
    const last = candles.at(-1);
    const key = `${chartCandles?.code}|${candles.length}|${last?.date}|${last?.close}|${ratioPoints.r2?.length}|${ratioPoints.h1?.length}`;
    if (plansCache?.key !== key) plansCache = { key, plans: [cybPlan(candles, ratioPoints.r2 ?? []), hsPlan(candles, ratioPoints.h1 ?? []), macdPlan(candles)] };
    return plansCache.plans;
  }
  // 顶部方案卡片里：三个方案按研究口径回测——全历史一行 + 逐年汇总一行（点开看每年明细）。不随图表区间变化。
  const planStatsBox = document.querySelector('#plan-stats') as HTMLElement;
  const expandedYears = new Set<string>();
  const backtestCache = new Map<string, { full?: PlanBacktest; yearly: ReturnType<typeof backtestPlanYearly> }>();
  let lastPlanStats: [PlanResult[], Candle[]] | undefined;
  planTagsBox.addEventListener('click', event => {
    const toggle = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-years]');
    if (!toggle || !lastPlanStats) return;
    const key = toggle.dataset.years!;
    if (expandedYears.has(key)) expandedYears.delete(key); else expandedYears.add(key);
    renderPlanStats(...lastPlanStats);
    planTagsBox.querySelector<HTMLButtonElement>(`[data-years="${key}"]`)?.focus({ preventScroll: true });
  });
  function planBacktests(plan: PlanResult, candles: Candle[]) {
    const points = plan.key === 'cyb' ? ratioPoints.r2 ?? [] : ratioPoints.h1 ?? [];
    const last = candles.at(-1);
    const cacheKey = `${chartCandles?.code}|${plan.key}|${candles.length}|${last?.date}|${last?.close}|${points.length}|${points.at(-1)?.date}`;
    let hit = backtestCache.get(cacheKey);
    if (!hit) {
      const bull = bullLookup(points);
      hit = { full: backtestPlan(plan.key, candles, bull), yearly: backtestPlanYearly(plan.key, candles, bull) };
      backtestCache.clear(); // 只留当前这一组，避免拖动时无限增长
      backtestCache.set(cacheKey, hit);
    }
    return hit;
  }
  // 分组标签后面的持仓徽章：按全历史连续信号判断当前持仓 / 空仓 / 待买入；对应买卖点未勾选时只提示。
  function renderHoldBadges(plans: PlanResult[], candles: Candle[]) {
    document.querySelectorAll<HTMLElement>('.plan-hold[data-plan]').forEach(badge => {
      const plan = plans.find(item => item.key === badge.dataset.plan);
      if (!plan) { badge.textContent = ''; return; }
      const open = planStats(planTrades(plan.signals, candles)).open;
      if (open) {
        const ret = `${open.ret > 0 ? '+' : ''}${(open.ret * 100).toFixed(1)}%`;
        badge.className = 'plan-hold holding';
        badge.innerHTML = `持仓中<em>${open.buyDate.slice(5)} 买入</em><b class="${open.ret > 0 ? 'up' : open.ret < 0 ? 'down' : ''}">${ret}</b>`;
      } else if (plan.pendingBuy) {
        badge.className = 'plan-hold pending'; badge.innerHTML = `待买入<em>${plan.pendingBuy.reason}，下一交易日开盘</em>`;
      } else {
        badge.className = 'plan-hold flat'; badge.textContent = '空仓';
      }
    });
  }
  function renderPlanStats(plans: PlanResult[], candles: Candle[]) {
    lastPlanStats = [plans, candles];
    renderHoldBadges(plans, candles);
    planStatsBox.hidden = !plans.length;
    if (!plans.length) { planStatsBox.innerHTML = ''; return; }
    const pctText = (value: number | undefined, signed = true) => value === undefined ? '—' : `${signed && value > 0 ? '+' : ''}${(value * 100).toFixed(1)}%`;
    const cls = (value: number | undefined) => value === undefined ? '' : value > 0 ? 'up' : value < 0 ? 'down' : '';
    const num = (value: number | undefined) => value === undefined ? '—' : value.toFixed(2);
    // 逐年回测不满一年，没有年化与卡玛，表中不列这两项。
    const cells = (r: PlanBacktest) =>
      `<td class="${cls(r.total)}"><b>${pctText(r.total)}</b></td>`
      + `<td class="${cls(r.mdd)}">${pctText(r.mdd)}</td>`
      + `<td class="${cls(r.hold)}">${pctText(r.hold)}</td>`
      + `<td>${r.natural ? `${r.natural}（${r.wins} / ${r.natural - r.wins}）` : '0'}</td><td>${pctText(r.winRate, false)}</td><td>${num(r.payoff)}</td><td class="${cls(r.avgRet)}">${pctText(r.avgRet)}</td>`
      + `<td><span class="${cls(r.best)}">${pctText(r.best)}</span> / <span class="${cls(r.worst)}">${pctText(r.worst)}</span></td>`;
    const statsOf = (plan: PlanResult) => {
      const { full, yearly } = planBacktests(plan, candles);
      const metric = (label: string, value: string, tone = '', tip = '') => `<div class="plan-metric"${tip ? ` title="${tip}"` : ''}><dt>${label}</dt><dd class="${tone}">${value}</dd></div>`;
      const overview = full
        ? `<div class="plan-period"><span>全历史回测</span><span>${full.first} — ${full.last}<i>·</i>${full.years.toFixed(1)} 年</span></div>`
          + `<dl class="plan-metrics">${metric('累计收益', pctText(full.total), cls(full.total))}${metric('年化收益', pctText(full.cagr), cls(full.cagr))}${metric('最大回撤', pctText(full.mdd), cls(full.mdd))}${metric('卡玛比率', num(full.calmar), '', '年化收益 ÷ 最大回撤的绝对值')}</dl>`
          + `<dl class="plan-secondary">${metric('一直持有', pctText(full.hold), cls(full.hold))}${metric('完成交易', `${full.natural}<small>（${full.wins}赚 / ${full.natural - full.wins}亏）</small>`)}${metric('胜率', pctText(full.winRate, false))}${metric('盈亏比', num(full.payoff))}${metric('单笔最好', pctText(full.best), cls(full.best))}${metric('单笔最差', pctText(full.worst), cls(full.worst))}</dl>`
        : '<p class="plan-empty">上市不足 240 个交易日，暂无全历史回测</p>';
      const sum = yearlySummary(yearly), open_ = expandedYears.has(plan.key);
      const summary = yearly.length
        ? `<div class="plan-year-head"><button type="button" class="year-toggle" data-years="${plan.key}" aria-expanded="${open_}" aria-controls="plan-years-${plan.key}"><span class="year-chevron" aria-hidden="true">›</span>年度表现<span class="year-toggle-hint">${open_ ? '收起' : '展开'}</span></button>`
          + `<div class="year-summary"><span><b>${sum.positive} / ${sum.years}</b> 年盈利</span><span>平均 <b class="${cls(sum.avg)}">${pctText(sum.avg)}</b></span><span>最差 <b class="${cls(sum.worst)}">${pctText(sum.worst)}</b></span></div></div>`
        : '';
      const yearRows = open_ ? yearly.map(({ year, result }) => `<tr class="year-row"><th scope="row" title="${result.first} ~ ${result.last}">${year}${result.sessions < 200 ? ` <span class="muted">（${result.sessions} 日）</span>` : ''}</th>${cells(result)}</tr>`).join('') : '';
      return overview + summary + `<div id="plan-years-${plan.key}" class="plan-stats-scroll"${open_ ? '' : ' hidden'} tabindex="0" role="region" aria-label="${PLAN_DEFS.find(def => def.key === plan.key)!.name}年度回测明细"><table><thead><tr><th scope="col">年份</th><th scope="col">收益</th><th scope="col">最大回撤</th><th scope="col">一直持有</th><th scope="col">完成交易（赚 / 亏）</th><th scope="col">胜率</th><th scope="col">盈亏比</th><th scope="col">单笔平均</th><th scope="col">单笔最好 / 最差</th></tr></thead><tbody>${yearRows}</tbody></table></div>`;
    };
    // 标签上的收益摘要、最优高亮、勾选框状态
    const calmarOf = new Map(plans.map(plan => [plan.key, planBacktests(plan, candles).full?.calmar ?? -Infinity]));
    const bestKey = [...calmarOf.entries()].sort((a, b) => b[1] - a[1])[0];
    for (const plan of plans) {
      const block = planTagsBox.querySelector<HTMLElement>(`[data-plan-block="${plan.key}"]`);
      block?.classList.toggle('is-best', !!bestKey && bestKey[1] > -Infinity && bestKey[0] === plan.key);
      const table = planTagsBox.querySelector<HTMLElement>(`[data-plan-stats="${plan.key}"]`);
      if (table) table.innerHTML = statsOf(plan);
      const def = PLAN_DEFS.find(item => item.key === plan.key)!;
      const view = planTagsBox.querySelector<HTMLInputElement>(`[data-plan-view="${plan.key}"]`);
      if (view) view.checked = (document.querySelector(def.trades) as HTMLInputElement).checked;
    }
    planStatsBox.innerHTML = '<details class="plan-method"><summary>回测口径与指标说明</summary><div class="plan-note">回测与研究口径一致：满仓进出、单边 0.1% 成本、上市第 121 根日线起交易。逐年 = 每个自然年单独回测：年初空仓起算、年末收盘平仓，当年可交易日不足 120 天不计。年化需满一年；卡玛 = 年化 ÷ |最大回撤|；盈亏比 = 平均盈利 ÷ |平均亏损|；单笔平均 = 已完成交易收益的算术平均（不含期末强制平仓）；一直持有 = 同一时段首日次日开盘买入、末日收盘卖出。</div></details>';
  }

  function bindRange() {
    document.querySelector('.range-presets')!.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest('button');
      if (!button || !chartInput) return;
      showRangeNote('');
      const key = button.dataset.range!;
      rangeKey = key;
      rangeTo = undefined;
      const latest = chartCandles?.candles.at(-1)?.date;
      rangeFrom = key === 'all' ? ALL_FROM : latest ? monthsBefore(latest, Number(key)) : undefined;
      void drawEquity();
    });
    const onDateChange = () => {
      if (!chartInput) return;
      const from = rangeFromInput.value, to = rangeToInput.value;
      if (!from || !to) { showRangeNote('请选择完整的起止日期'); void drawEquity(); return; }
      if (from > to) { showRangeNote('日期范围有误：起点不能晚于终点'); void drawEquity(); return; } // 恢复为原区间
      showRangeNote('');
      rangeKey = 'custom'; rangeFrom = from; rangeTo = to;
      void drawEquity();
    };
    rangeFromInput.addEventListener('change', onDateChange);
    rangeToInput.addEventListener('change', onDateChange);
  }
  bindRange();

  // ---------- 日K拖动平移、缩放 ----------
  // 鼠标拖动 / 单指左右滑动平移；双指捏合、⌘/Ctrl + 滚轮（触控板捏合同样如此）缩放；触控板左右滑动或 Shift + 滚轮平移；也可用按钮。
  // 只改显示区间（起止日期），用已取的日线同步重绘；拖到已取日线的最左端松手时再按区间向前补取行情。
  function currentViewport(): Viewport | undefined {
    if (!chartInput || !chartCandles?.candles.length) return undefined;
    const candles = chartCandles.candles, from = rangeFrom ?? chartInput.openDate;
    let start = candles.findIndex(candle => candle.date >= from); if (start < 0) start = candles.length - 1;
    let end = candles.length - 1;
    if (rangeTo) { while (end > start && candles[end].date > rangeTo) end--; }
    return { start, end };
  }
  let viewFrame = 0;
  function applyViewport(view: Viewport) {
    const candles = chartCandles?.candles;
    if (!candles?.length || view.end < view.start) return;
    rangeFrom = candles[view.start].date;
    rangeTo = view.end >= candles.length - 1 ? undefined : candles[view.end].date; // 右端在最新一根时继续跟随最新行情
    rangeKey = 'custom'; showRangeNote('');
    if (!viewFrame) viewFrame = requestAnimationFrame(() => { viewFrame = 0; renderChart(); });
  }
  // 松手后：左端已到已取日线的第一根，按新区间向前补取（drawEquity 会多取 6 个月）。
  function settleViewport() {
    const view = currentViewport();
    if (view && view.start === 0) void drawEquity();
  }
  const zoomBy = (factor: number, anchor = .5) => { const view = currentViewport(); if (view) applyViewport(zoomViewport(chartCandles!.candles.length, view, factor, anchor)); };
  const panBy = (delta: number) => { const view = currentViewport(); if (view) applyViewport(panViewport(chartCandles!.candles.length, view, delta)); };
  // 指针位置换算：viewBox 坐标、相对绘图区的比例、每根日线的宽度
  function plotGeometry(clientX: number) {
    const bounds = equitySvg.getBoundingClientRect(), data = equitySvg.dataset;
    const scale = Number(data.viewWidth) / bounds.width, left = Number(data.plotLeft), plotWidth = Number(data.plotWidth), count = Number(data.plotCount);
    const xx = (clientX - bounds.left) * scale;
    return { scale, slot: plotWidth / Math.max(1, count), anchor: Math.min(1, Math.max(0, (xx - left) / plotWidth)) };
  }
  function bindPanZoom() {
    equitySvg.addEventListener('wheel', event => {
      if (!currentViewport()) return;
      if (event.ctrlKey || event.metaKey) {
        event.preventDefault();
        zoomBy(Math.exp(Math.max(-50, Math.min(50, event.deltaY)) * .006), plotGeometry(event.clientX).anchor); // 鼠标滚轮一格约 ±35%，触控板捏合更细腻
      } else if (event.shiftKey || Math.abs(event.deltaX) > Math.abs(event.deltaY)) {
        event.preventDefault();
        const { scale, slot } = plotGeometry(event.clientX);
        panBy((event.shiftKey && !event.deltaX ? event.deltaY : event.deltaX) * scale / slot);
        clearTimeout(wheelSettle); wheelSettle = setTimeout(settleViewport, 300);
      } // 普通竖向滚轮照常滚动页面
    }, { passive: false });
    let wheelSettle: ReturnType<typeof setTimeout> | undefined;
    const pointers = new Map<number, number>(); // pointerId → clientX
    let drag: { x: number; view: Viewport; moved: boolean } | undefined;
    let pinch: { distance: number; view: Viewport; anchor: number } | undefined;
    const spread = () => { const xs = [...pointers.values()]; return Math.max(8, Math.abs(xs[0] - xs[1])); };
    equitySvg.addEventListener('pointerdown', event => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      const view = currentViewport();
      if (!view) return;
      pointers.set(event.pointerId, event.clientX);
      if (pointers.size === 1) { drag = { x: event.clientX, view, moved: false }; pinch = undefined; }
      else if (pointers.size === 2) {
        const xs = [...pointers.values()];
        drag = undefined; pinch = { distance: spread(), view, anchor: plotGeometry((xs[0] + xs[1]) / 2).anchor };
      }
      try { equitySvg.setPointerCapture(event.pointerId); } catch { /* 部分浏览器对 SVG 子元素不支持 */ }
    });
    equitySvg.addEventListener('pointermove', event => {
      if (!pointers.has(event.pointerId) || !chartCandles) return;
      pointers.set(event.pointerId, event.clientX);
      if (pinch && pointers.size >= 2) {
        applyViewport(zoomViewport(chartCandles.candles.length, pinch.view, pinch.distance / spread(), pinch.anchor));
      } else if (drag) {
        const dx = event.clientX - drag.x;
        if (!drag.moved && Math.abs(dx) < 4) return; // 小幅移动仍当作点击查看十字光标
        drag.moved = true; equitySvg.style.cursor = 'grabbing';
        const { scale, slot } = plotGeometry(event.clientX);
        applyViewport(panViewport(chartCandles.candles.length, drag.view, -dx * scale / slot)); // 向右拖看更早的日期
      }
    });
    const release = (event: PointerEvent) => {
      if (!pointers.delete(event.pointerId)) return;
      const changed = drag?.moved || !!pinch;
      // 双指松开一指：剩下的手指从当前位置接着平移
      if (pointers.size === 1 && pinch) { const x = [...pointers.values()][0], view = currentViewport(); pinch = undefined; drag = view ? { x, view, moved: true } : undefined; return; }
      if (!pointers.size) { drag = undefined; pinch = undefined; equitySvg.style.cursor = ''; if (changed) settleViewport(); }
    };
    equitySvg.addEventListener('pointerup', release);
    equitySvg.addEventListener('pointercancel', release);
  }
  bindPanZoom();

  // ---------- 支撑 / 压力区间 ----------
  const levelsPanel = document.querySelector('#levels-panel') as HTMLElement;
  const levelsNote = document.querySelector('#levels-note') as HTMLElement;
  let levelsDirty = false; // 用户正在输入、尚未保存时，别的刷新不覆盖输入框
  type LevelKind = 'support' | 'resistance';
  const levelPrefix = (kind: LevelKind) => kind === 'support' ? 'S' : 'R';
  const rowsOf = (kind: LevelKind) => document.querySelector(`#levels-panel .level-rows[data-kind="${kind}"]`) as HTMLElement;
  const showLevelsNote = (text: string, tone: 'error' | 'hint' | 'ok' = 'error') => { levelsNote.textContent = text; levelsNote.hidden = !text; levelsNote.className = `levels-note${tone === 'error' ? '' : ` ${tone}`}`; };
  // 编号按列表顺序生成，增删后重新编号；达到上限时禁用“添加”
  function renumberLevels(kind: LevelKind) {
    const rows = [...rowsOf(kind).children] as HTMLElement[];
    rows.forEach((row, index) => {
      const name = `${levelPrefix(kind)}${index + 1}`;
      (row.querySelector('b') as HTMLElement).textContent = name;
      row.querySelectorAll<HTMLElement>('input, select').forEach(input => input.setAttribute('aria-label', `${name} ${({ low: '下沿', high: '上沿', note: '备注', strength: '强度' } as Record<string, string>)[input.dataset.field!]}`));
    });
    (document.querySelector(`#levels-panel .level-add[data-kind="${kind}"]`) as HTMLButtonElement).disabled = rows.length >= MAX_LEVELS;
  }
  function addLevelRow(kind: LevelKind, level?: { low: number; high: number; note?: string }) {
    const row = document.createElement('div');
    row.className = 'level-row';
    row.innerHTML = '<b></b><input type="number" step="0.001" min="0" inputmode="decimal" placeholder="下沿" data-field="low"><span>~</span>'
      + '<input type="number" step="0.001" min="0" inputmode="decimal" placeholder="上沿" data-field="high">'
      + '<select class="level-strength" data-field="strength"><option value="1">弱 ★☆☆</option><option value="2" selected>中 ★★☆</option><option value="3">强 ★★★</option></select>'
      + '<input type="text" maxlength="30" placeholder="备注（可选）" class="level-note" data-field="note"><button type="button" class="level-del" aria-label="删除">×</button>';
    (row.querySelector('[data-field="low"]') as HTMLInputElement).value = level ? String(level.low) : '';
    (row.querySelector('[data-field="high"]') as HTMLInputElement).value = level ? String(level.high) : '';
    (row.querySelector('[data-field="note"]') as HTMLInputElement).value = level?.note ?? '';
    (row.querySelector('[data-field="strength"]') as HTMLSelectElement).value = String(level?.strength ?? 2);
    rowsOf(kind).append(row);
    renumberLevels(kind);
  }
  function fillLevels(levels?: Levels) {
    for (const kind of ['support', 'resistance'] as const) {
      rowsOf(kind).replaceChildren();
      const list = levels?.[kind] ?? [];
      list.forEach(level => addLevelRow(kind, level));
      if (!list.length) addLevelRow(kind); // 没有区间时默认留一个空行，方便直接填写
    }
  }
  function readLevelsForm() {
    const form = { support: [] as { low: string; high: string; note: string; strength: string }[], resistance: [] as { low: string; high: string; note: string; strength: string }[] };
    for (const kind of ['support', 'resistance'] as const) for (const row of [...rowsOf(kind).children]) {
      const get = (field: string) => (row.querySelector(`[data-field="${field}"]`) as HTMLInputElement | HTMLSelectElement).value;
      form[kind].push({ low: get('low'), high: get('high'), note: get('note'), strength: get('strength') });
    }
    return form;
  }
  async function saveLevels(levels: Levels | undefined) {
    if (!record || viewBackup || !chartInput) return;
    editRevision++; // 保存期间到达的行情刷新结果会被丢弃，避免覆盖
    record = { ...record, levels, updatedAt: new Date().toISOString() };
    saveRecord(record);
    levelsDirty = false;
    chartInput = { ...chartInput, levels };
    fillLevels(levels); // 按保存后的结果重建列表：忽略的空行消失，编号重新排列
    void drawEquity(); // 只重绘曲线，不重算回测
    // 支撑高于现价、压力低于现价：只提示，不拦截（突破后角色会互换）
    const current = record.result.current, odd = [
      ...(levels?.support ?? []).flatMap((level, index) => level.low > current ? [`S${index + 1}`] : []),
      ...(levels?.resistance ?? []).flatMap((level, index) => level.high < current ? [`R${index + 1}`] : []),
    ];
    const oddText = odd.length ? `提示：${odd.join('、')} 的位置与现价关系和名称相反，仍按你的设置显示。` : '';
    showLevelsNote('已保存到本机，正在同步到云端数据库…', 'hint');
    const problem = await pushRecord(record, '区间');
    if (problem) showLevelsNote(`${problem}${oddText}`, 'hint');
    else showLevelsNote(`已保存，并已同步到云端数据库。${oddText}`, odd.length ? 'hint' : 'ok');
  }
  function bindLevels() {
    levelsPanel.addEventListener('input', () => { levelsDirty = true; showLevelsNote(''); });
    levelsPanel.addEventListener('click', event => {
      const target = event.target as HTMLElement;
      const add = target.closest('.level-add') as HTMLButtonElement | null;
      if (add) { addLevelRow(add.dataset.kind as LevelKind); levelsDirty = true; showLevelsNote(''); return; }
      const del = target.closest('.level-del');
      if (del) {
        const row = del.closest('.level-row') as HTMLElement, kind = (row.parentElement as HTMLElement).dataset.kind as LevelKind;
        row.remove();
        if (!rowsOf(kind).children.length) addLevelRow(kind); // 删光后留一个空行
        renumberLevels(kind); levelsDirty = true; showLevelsNote('');
      }
    });
    document.querySelector('#levels-save')!.addEventListener('click', () => {
      const { levels, error } = parseLevels(readLevelsForm());
      if (error) { showLevelsNote(error); return; }
      void saveLevels(levels);
    });
    document.querySelector('#levels-clear')!.addEventListener('click', () => {
      if (!chartInput?.levels && !levelsDirty) return;
      fillLevels(undefined);
      void saveLevels(undefined);
    });
  }
  bindLevels();

  // ---------- 斐波那契 ----------
  const fibPanel = document.querySelector('#fib-panel') as HTMLElement;
  const fibNote = document.querySelector('#fib-note') as HTMLElement;
  const viewLevelsBox = document.querySelector('#view-levels') as HTMLInputElement;
  const viewFibBox = document.querySelector('#view-fib') as HTMLInputElement;
  const viewGridBox = document.querySelector('#view-grid') as HTMLInputElement;
  const fibEl = (id: string) => document.querySelector(`#fib-${id}`) as HTMLInputElement;
  const fibSelect = document.querySelector('#fib-set') as HTMLSelectElement;
  const fibExtBoxes = () => [...document.querySelectorAll<HTMLInputElement>('input[name="fib-ext"]')];
  let fibSets: FibSet[] = []; // 已保存的各组
  let fibNewId: string | undefined; // 正在新建、尚未保存的一组
  let fibDraft: Fib | undefined; // 已「确认」但尚未保存的斐波那契：只在图中显示，刷新行情时保持
  let fibDirty = false;
  const activeSetOf = (sets: FibSet[], view?: View) => sets.find(item => item.id === view?.fibActive) ?? sets[0];
  // 图中显示的斐波那契：已确认的草稿优先；新建中没有草稿则不显示；否则是选中的那一组。
  const fibNow = (item: SavedRecord) => fibDraft ?? (fibNewId ? undefined : activeSetOf(normalizeFibSets(item), normalizeView(item.view))?.fib);
  const newFibId = () => `f${Date.now().toString(36)}${Math.random().toString(36).slice(2, 5)}`;
  const showFibNote = (text: string, tone: 'error' | 'hint' | 'ok' = 'error') => { fibNote.textContent = text; fibNote.hidden = !text; fibNote.className = `levels-note${tone === 'error' ? '' : ` ${tone}`}`; };
  function fillFib(fib?: Fib) {
    fibEl('start-date').value = fib?.start.date ?? ''; fibEl('start-price').value = fib ? String(fib.start.price) : '';
    fibEl('end-date').value = fib?.end.date ?? ''; fibEl('end-price').value = fib ? String(fib.end.price) : '';
    fibExtBoxes().forEach(box => { box.checked = fib ? fib.ext.includes(Number(box.value)) : true; });
  }
  function readFibForm() {
    return { startPrice: fibEl('start-price').value, startDate: fibEl('start-date').value, endPrice: fibEl('end-price').value, endDate: fibEl('end-date').value, ext: fibExtBoxes().filter(box => box.checked).map(box => Number(box.value)) };
  }
  // 读取并校验输入；价格都留空而两个日期都填了时，按日期从日线里自动取高低点并回填输入框。
  async function resolveFibForm(): Promise<{ fib?: Fib; error?: string }> {
    const form = readFibForm();
    const noPrice = !form.startPrice.trim() && !form.endPrice.trim();
    if (!noPrice || (!form.startDate && !form.endDate)) return parseFib(form);
    if (!form.startDate || !form.endDate) return { error: '只按日期设置时，起点和终点两个日期都要填' };
    if (!chartInput) return { error: '页面还没加载完' };
    showFibNote('正在按日期读取K线…', 'hint');
    try {
      const begin = new Date(`${[form.startDate, form.endDate].sort()[0]}T00:00:00Z`); begin.setUTCDate(begin.getUTCDate() - 10); // 往前多取几天，便于非交易日取前一个交易日
      const candles = mergeQuote(await getCandles(chartInput.code, begin.toISOString().slice(0, 10)), (await fetchQuotes([chartInput.code])).get(chartInput.code));
      const result = fibFromDates(candles, form.startDate, form.endDate);
      if (!result.fib) return result;
      const fib = { ...result.fib, ext: form.ext };
      fillFib(fib); // 回填取到的价格与实际的交易日期，延长线勾选保持用户的选择
      fibDirty = true;
      return { fib };
    } catch { return { error: '行情获取失败，请稍后再试或手动输入价格' }; }
  }
  // 下拉与名称框：列出已保存的各组，新建中追加一项「（新建，未保存）」。
  function renderFibSelect(setName = true) {
    const active = activeSetOf(fibSets, chartInput?.view);
    fibSelect.innerHTML = fibSets.map(item => `<option value="${item.id}">${item.name.replace(/[<>&"]/g, '')}</option>`).join('')
      + (fibNewId || !fibSets.length ? '<option value="__new">（新建，未保存）</option>' : '');
    fibSelect.value = fibNewId || !fibSets.length ? '__new' : active!.id;
    if (setName) fibEl('name').value = fibNewId || !fibSets.length ? `斐波那契 ${fibSets.length + 1}` : active!.name;
    (document.querySelector('#fib-new') as HTMLButtonElement).disabled = fibSets.length >= MAX_FIB_SETS;
    (document.querySelector('#fib-delete') as HTMLButtonElement).hidden = !fibSets.length && !fibNewId;
  }
  function syncViewBoxes() {
    if (!chartInput) return;
    const now = shown(chartInput);
    viewLevelsBox.checked = now.levels; viewFibBox.checked = now.fib; viewGridBox.checked = now.grid;
    syncPanels();
  }
  // 编辑面板只在勾选对应显示开关时出现；备份视图只读，始终隐藏。
  function syncPanels() {
    levelsPanel.hidden = !!viewBackup || !viewLevelsBox.checked;
    fibPanel.hidden = !!viewBackup || !viewFibBox.checked;
  }
  // 保存本记录的修改（本机 + 云端）；备份视图只读，不保存。
  async function persistRecord(patch: Partial<SavedRecord>, what: string, note: (text: string, tone?: 'error' | 'hint' | 'ok') => void) {
    if (!record || viewBackup) return;
