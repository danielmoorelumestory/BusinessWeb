---
import '../styles/global.css';
import { href } from '../lib/url';

// 笔记、行业专栏、RSS 已迁入主站；notes 只保留网格交易与股市分析两个实验页，页头的链接指回主站。
// 同域托管（Cloudflare 构建）时 MAIN_SITE 是站点根 '/'；其他环境默认指向线上主站。
const mainSite = (process.env.MAIN_SITE || 'https://businessweb-c0u.pages.dev/').replace(/\/?$/, '/');

interface Props {
  title?: string;
  description?: string;
  current?: 'lab';
  /** 宽内容（表格类 lab），放宽 main 最大宽度 */
  wide?: boolean;
}

const { title, description = '网格交易与股市分析。', current, wide = false } = Astro.props;
const pageTitle = title ? `${title} · 实验` : '实验 · 网格交易与股市分析';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={href('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="site-header">
      <div class="top mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a class="brand" href={mainSite}>
          <span class="brand-icon">Live</span>
          <span class="brand-title">返回主站</span>
          <span class="brand-tag">网格交易 · 股市分析</span>
        </a>
        <nav class="nav">
          <a href={href('lab')} aria-current={current === 'lab' ? 'page' : undefined}>实验</a>
          <a href={href('lab/grid-trading')}>网格交易</a>
          <a href={href('lab/stock')}>股市分析</a>
          <a href={`${mainSite}notes`}>笔记</a>
        </nav>
      </div>
    </header>
    <main class:list={['mx-auto px-4 py-8 sm:px-6 sm:py-10', wide ? 'max-w-7xl' : 'max-w-5xl']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="foot-inner mx-auto flex max-w-5xl flex-wrap items-start justify-between gap-4 px-4 py-8 sm:px-6">
        <div>
          <div class="foot-brand">Live · 实验</div>
          <p class="foot-desc">网格交易与股市分析与主站同域部署，笔记与行业研究在主站。</p>
        </div>
        <div class="foot-links">
          <a href={mainSite}>主站首页</a>
          <a href={`${mainSite}notes`}>行业研究笔记</a>
        </div>
      </div>
    </footer>
  </body>
</html>
