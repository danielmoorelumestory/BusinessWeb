{
  "name": "grid-trading-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  // 北京时间每个工作日 15:10、16:00 与次日 09:00（UTC 07:10、08:00、01:00），同一交易日重叠抓取、单次失败有重试机会；
  // 节假日抓到的是重复数据，按主键覆盖，不会增加行数。
  // 盘中每15分钟只更新过期复盘指标；分钟线/CLS维持原定时任务。
  // 星期用名称写：Cloudflare 的数字星期是 1 = 周日，写 1-5 会变成周日到周四、周五不跑。
  "triggers": { "crons": ["10 7 * * MON-FRI", "0 8 * * MON-FRI", "0 1 * * MON-FRI", "30,45 1 * * MON-FRI", "*/15 2-3,5-7 * * MON-FRI"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grid-trading-sync",
      "database_id": "5751f7b7-e0c4-4820-8ce1-a1e5943712b2"
    }
  ]
}
